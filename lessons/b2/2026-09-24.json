aning": "to need something", "example": "This task requires patience.", "pronunciation": "rih-KWY-ur", "persian": "نیاز داشتن، لازم داشتن", "photo": "media/b2/2026-09-24/photos/require.jpg", "word_audio": "media/b2/2026-09-24/word-audio/require.mp3"}, {"word": "responsibility", "pos": "noun", "meaning": "a duty you must do", "example": "It is your responsibility to be on time.", "pronunciation": "rih-spon-suh-BIL-uh-tee", "persian": "مسئولیت", "photo": "media/b2/2026-09-24/photos/responsibility.jpg", "word_audio": "media/b2/2026-09-24/word-audio/responsibility.mp3"}, {"word": "succeed", "pos": "verb", "meaning": "to achieve success", "example": "Hard work helps you succeed.", "pronunciation": "suk-SEED", "persian": "موفق شدن", "photo": "media/b2/2026-09-24/photos/succeed.jpg", "word_audio": "media/b2/2026-09-24/word-audio/succeed.mp3"}, {"word": "suggest", "pos": "verb", "meaning": "to propose an idea", "example": "I suggest taking a short break.", "pronunciation": "suh-JEST", "persian": "پیشنهاد دادن", "photo": "media/b2/2026-09-24/photos/suggest.jpg", "word_audio": "media/b2/2026-09-24/word-audio/suggest.mp3"}, {"word": "support", "pos": "verb", "meaning": "to help someone", "example": "Good friends support each other.", "pronunciation": "suh-PORT", "persian": "حمایت کردن", "photo": "media/b2/2026-09-24/photos/support.jpg", "word_audio": "media/b2/2026-09-24/word-audio/support.mp3"}, {"word": "valuable", "pos": "adjective", "meaning": "very useful or important", "example": "Time is valuable.", "pronunciation": "VAL-yoo-uh-bul", "persian": "ارزشمند", "photo": "media/b2/2026-09-24/photos/valuable.jpg", "word_audio": "media/b2/2026-09-24/word-audio/valuable.mp3"}, {"word": "experience", "pos": "noun", "meaning": "knowledge you get from doing things", "example": "Travel gives you great experience.", "pronunciation": "ik-SPEER-ee-uns", "persian": "تجربه", "photo": "media/b2/2026-09-24/photos/experience.jpg", "word_audio": "media/b2/2026-09-24/word-audio/experience.mp3"