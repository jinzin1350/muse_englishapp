  "grammar": {
    "title": "Was and Were",
    "explanation": "**Was** and **were** are the past of **be**. They talk about yesterday, not today.\n\nUse **was** with I, he, she, and it. Use **were** with you, we, and they.\n\nFor no, use **wasn't** and **weren't**. Do not use did with **was** and **were**.\n\nUse **there was** for one thing. Use **there were** for many things.\n\n**Was born** talks about birth. She **was born** in Mexico.",
    "examples": [
      "*I **was** at home yesterday.* (I + was)",
      "*The film **was** really funny.* (it + was)",
      "*My parents **were** teachers.* (they + were)",
      "*We **weren't** hungry.* (negative)",
      "*Was it cold in Paris?* (question)",
      "*Where **were** you last night?* (wh- question)"
    ],
    "practice": [
      {
        "q": "I am tired today. Say it about yesterday.",
        "a": "I was tired yesterday."
      },
      {
        "q": "They are at school now. Say it about yesterday.",
        "a": "They were at school yesterday."
      },
      {
        "q": "It is cloudy today. Say it about yesterday.",
        "a": "It was cloudy yesterday."
      },
      {
        "q": "You are happy now. Ask about yesterday.",
        "a": "Were you happy yesterday?"
      }
    ],
