    "q": "Correct the sentence: She decided going home.",
    "a": "She decided to go home."
   },
   {
    "q": "Rewrite with the gerund: Thank you for (help) me.",
    "a": "Thank you for helping me."
   },
   {
    "q": "Rewrite with to + verb, using the word act: We ___ now.",
    "a": "We decided to act now."
   }
  ],
