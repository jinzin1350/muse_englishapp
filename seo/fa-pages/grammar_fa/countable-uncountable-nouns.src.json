"cun-units.b0.2.1": "*water, juice, coffee, tea*",
"cun-units.b0.3.0": "*a loaf of*",
"cun-units.b0.3.1": "*bread*",
"cun-units.b0.4.0": "*a bar of*",
"cun-units.b0.4.1": "*chocolate, soap*",
"cun-units.b0.5.0": "*a carton of*",
