"cun-tricky.b0.4.1": "*a bag, a suitcase*",
"cun-tricky.b0.5.0": "*homework*",
"cun-tricky.b0.5.1": "*an exercise, a task*",
"cun-tricky.b0.6.0": "*work*",
"cun-tricky.b0.6.1": "*a job*",
"cun-tricky.b0.7.0": "*travel*",
"cun-tricky.b0.7.1": "*a trip, a journey*",
"cun-tricky.b0.8.0": "*weather*",
"cun-tricky.b0.8.1": "no countable form: *What lovely weather!*",
"cun-tricky.b1": "These nouns take a **singular verb** and no *-s*: *The information **is** on the website. Your advice **was** very helpful.*",
"cun-tricky.b2": "Use *some, any, much, a lot of* or *a piece of* with them: *Can I give you **some advice**? I don't have **much homework**.*",
"cun-tricky.n0": "some + uncountable",
"cun-tricky.n1": "a lot of",
"cun-tricky.n2": "singular verb",
"cun-tricky.n3": "job / work",
"cun-tricky.w0": "advice: no a",
"cun-tricky.w1": "furniture: no -s",
"cun-tricky.w2": "news: singular verb",
"cun-tricky.w3": "travel: uncountable → trip",
"cun-units.t": "A piece of, a slice of, a bottle of",
"cun-units.s": "To count uncountable nouns, use a **unit**: *a piece of cake, a slice of bread, a bottle of water, a cup of coffee, a bar of chocolate, a loaf of bread*.",
