"phonetic": "frend", "levels": ["a1"], "pos": "noun", "meaning_en": "a person you know and like.", "meaning_fa": "دوست", "example_en": "She is my best friend.", "photo": "media/vocab/friend.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/friend.mp3"}, {"word": "gardening", "phonetic": "ˈgɑːdənɪŋ", "levels": ["a1"], "pos": "noun", "meaning_en": "the activity of working in a garden.", "meaning_fa": "باغبانی", "example_en": "My hobby is gardening.", "photo": "media/vocab/gardening.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/gardening.mp3"}, {"word": "gather", "phonetic": "ˈgæðə", "levels": ["a2"], "pos": "verb", "meaning_en": "to come together in a group.", "meaning_fa": "جمع شدن، گرد آمدن", "example_en": "Friends often gather at the cafe.", "photo": "media/vocab/gather.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/gather.mp3"}, {"word": "grow flowers / vegetables", "phonetic": "grəʊ flaʊəz / ˈvedʒtəbəlz", "levels": ["a1"], "pos": "phrase", "meaning_en": "to cultivate plants for beauty or food.", "meaning_fa": "گل/سبزیجات کاشتن", "example_en": "My hobby is to grow flowers.", "photo": "media/vocab/grow-flowers-vegetables.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/grow-flowers-vegetables.mp3"}, {"word": "harbour", "phonetic": "ˈhɑːbə", "levels": ["a2"], "pos": "noun", "meaning_en": "A place where ships can stay safely.", "meaning_fa": "بندر، لنگرگاه", "example_en": "The boats were safe in the harbour.", "photo": "media/vocab/harbour.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/harbour.mp3"}, {"word": "have", "phonetic": "hæv", "levels": ["a1"], "pos": "verb", "meaning_en": "To own or possess something.", "meaning_fa": "داشتن", "example_en": "I have a big house.", "photo": "media/vocab/have.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/have.mp3"}, {"word": "have a sleep", "phonetic": "hæv ə sliːp", "levels": ["a1"], "pos": "phrase", "meaning_en": "Take a short rest or nap.", "meaning_fa": "چرت زدن، خوابیدن", "example_en": "I need to have a sleep after lunch.", "photo": "media/vocab/have-a-sleep.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/have-a-sleep.mp3"}, {"word": "have friends round", "phonetic": "hæv frendz raʊnd", "levels": ["a1"], "pos": "phrase", "meaning_en": "Invite friends to your house.", "meaning_fa": "دوستان را به خانه دعوت کردن", "example_en": "We often have friends round on weekends.", "photo": "media/vocab/have-friends-round.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/have-friends-round.mp3"}, {"word": "headphones", "phonetic": "ˈhedfəʊnz", "levels": ["a1"], "pos": "noun", "meaning_en": "Device worn on ears to listen to sound.", "meaning_fa": "هدفون", "example_en": "I use headphones to listen to music.", "photo": "media/vocab/headphones.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/headphones.mp3"}, {"word": "held [organised]", "phonetic": "held", "levels": ["a2"], "pos": "verb", "meaning_en": "To organize or have an event.", "meaning_fa": "برگزار شد", "example_en": "The party was held at my house.", "photo": "media/vocab/held-organised.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/held-organised.mp3"}, {"word": "hobby", "phonetic": "ˈhɒbi", "levels": ["a1"], "pos": "noun", "meaning_en": "An activity you do for pleasure in your free time.", "meaning_fa": "سرگرمی، تفریح", "example_en": "My hobby is collecting stamps.", "photo": "media/vocab/hobby.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hobby.mp3"}, {"word": "home", "phonetic": "həʊm", "levels": ["a1"], "pos": "noun", "meaning_en": "The place where you live.", "meaning_fa": "خانه", "example_en": "I want to go home now.", "photo": "media/vocab/home.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/home.mp3"}, {"word": "Internet", "phonetic": "ˈɪntənet", "levels": ["a1"], "pos": "proper noun", "meaning_en": "A global computer network.", "meaning_fa": "اینترنت", "example_en": "I use the Internet every day.", "photo": "media/vocab/internet.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/internet.mp3"}, {"word": "involve", "phonetic": "ɪnˈvɒlv", "levels": ["a2"], "pos": "verb", "meaning_en": "To include someone or something in an activity.", "meaning_fa": "شامل شدن، درگیر کردن", "example_en": "My job involves a lot of travel.", "photo": "media/vocab/involve.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/involve.mp3"}, {"word": "last v", "phonetic": "lɑːst", "levels": ["a2"], "pos": "verb", "meaning_en": "To continue for a period of time.", "meaning_fa": "طول کشیدن", "example_en": "The class lasts for one hour.", "photo": "media/vocab/last-v.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/last-v.mp3"}, {"word": "listen (to)", "phonetic": "ˈlɪsən", "levels": ["a1"], "pos": "verb", "meaning_en": "To pay attention to sounds.", "meaning_fa": "گوش دادن", "example_en": "I like to listen to music.", "photo": "media/vocab/listen-to.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/listen-to.mp3"}, {"word": "magazine", "phonetic": "ˌmægəˈziːn", "levels": ["a1"], "pos": "noun", "meaning_en": "a thin book with stories and pictures, published regularly.", "meaning_fa": "مجله", "example_en": "I read a magazine on the train.", "photo": "media/vocab/magazine.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/magazine.mp3"}, {"word": "Morocco", "phonetic": "məˈrɒkəʊ", "levels": ["a1"], "pos": "noun", "meaning_en": "a country in North Africa", "meaning_fa": "مراکش", "example_en": "We went on holiday to Morocco.", "photo": "media/vocab/morocco.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/morocco.mp3"}, {"word": "newspaper", "phonetic": "ˈnjuːzˌpeɪpə", "levels": ["a1"], "pos": "noun", "meaning_en": "A paper with news, read daily.", "meaning_fa": "روزنامه", "example_en": "My dad reads the newspaper.", "photo": "media/vocab/newspaper.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/newspaper.mp3"}, {"word": "nothing", "phonetic": "ˈnʌθɪŋ", "levels": ["a1"], "pos": "pronoun", "meaning_en": "Not anything; no single thing.", "meaning_fa": "هیچ چیز", "example_en": "There is nothing in the box.", "photo": "media/vocab/nothing.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/nothing.mp3"}, {"word": "novel", "phonetic": "ˈnɒvəl", "levels": ["a1"], "pos": "noun", "meaning_en": "A long written story, usually in a book.", "meaning_fa": "رمان", "example_en": "I am reading a good novel.", "photo": "media/vocab/novel.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/novel.mp3"}, {"word": "on the phone", "phonetic": "ɒn ðə fəʊn", "levels": ["a1"], "pos": "phrase", "meaning_en": "Talking using a telephone.", "meaning_fa": "پای تلفن، در حال مکالمه", "example_en": "She is on the phone with her friend.", "photo": "media/vocab/on-the-phone.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/on-the-phone.mp3"}, {"word": "online", "phonetic": "ˌɒnˈlaɪn", "levels": ["a1"], "pos": "adjective/adverb", "meaning_en": "Connected to the internet.", "meaning_fa": "آنلاین، اینترنتی", "example_en": "I bought my new shoes online.", "photo": "media/vocab/online.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/online.mp3"}, {"word": "parade", "phonetic": "pəˈreɪd", "levels": ["a2"], "pos": "noun", "meaning_en": "A public procession, often with music and costumes.", "meaning_fa": "رژه، راهپیمایی", "example_en": "We watched the colorful parade in the street.", "photo": "media/vocab/parade.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/parade.mp3"}, {"word": "phone", "phonetic": "fəʊn", "levels": ["a1"], "pos": "noun", "meaning_en": "A device for talking to people.", "meaning_fa": "تلفن، گوشی", "example_en": "My phone is ringing.", "photo": "media/vocab/phone.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/phone.mp3"}, {"word": "play", "phonetic": "pleɪ", "levels": ["a1"], "pos": "verb", "meaning_en": "to take part in a game or sport.", "meaning_fa": "بازی کردن", "example_en": "Do you want to play football?", "photo": "media/vocab/play.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/play.mp3"}, {"word": "play video games", "phonetic": "pleɪ ˈvɪdɪəʊ geimz", "levels": ["a1"], "pos": "phrase", "meaning_en": "to play electronic games on a screen.", "meaning_fa": "بازی ویدیویی کردن", "example_en": "My brother loves to play video games.", "photo": "media/vocab/play-video-games.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/play-video-games.mp3"}, {"word": "programme", "phonetic": "ˈprəʊgræm", "levels": ["a1"], "pos": "noun", "meaning_en": "A show on TV or radio.", "meaning_fa": "برنامه", "example_en": "What's your favorite TV programme?", "photo": "media/vocab/programme.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/programme.mp3"}, {"word": "radio", "phonetic": "ˈreɪdiəʊ", "levels": ["a1"], "pos": "noun", "meaning_en": "a device for listening to music and news", "meaning_fa": "رادیو", "example_en": "I listen to the radio in the car.", "photo": "media/vocab/radio.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/radio.mp3"}, {"word": "read", "phonetic": "riːd", "levels": ["a1"], "pos": "verb", "meaning_en": "to look at and understand written words", "meaning_fa": "خواندن", "example_en": "I like to read books.", "photo": "media/vocab/read.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/read.mp3"}, {"word": "see", "phonetic": "siː", "levels": ["a1"], "pos": "verb", "meaning_en": "To watch a film or play.", "meaning_fa": "دیدن (فیلم، نمایش)", "example_en": "Did you see the new movie?", "photo": "media/vocab/see.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/see.mp3"}, {"word": "sleep", "phonetic": "sliːp", "levels": ["a1"], "pos": "verb", "meaning_en": "To rest with your eyes closed.", "meaning_fa": "خوابیدن", "example_en": "I like to sleep late.", "photo": "media/vocab/sleep.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/sleep.mp3"}, {"word": "spectacular", "phonetic": "spekˈtækjələ", "levels": ["a2"], "pos": "adjective", "meaning_en": "Very impressive and exciting to see.", "meaning_fa": "تماشایی، دیدنی", "example_en": "The fireworks show was spectacular.", "photo": "media/vocab/spectacular.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/spectacular.mp3"}, {"word": "stay", "phonetic": "steɪ", "levels": ["a1"], "pos": "verb", "meaning_en": "To remain in a place.", "meaning_fa": "ماندن", "example_en": "I want to stay home tonight.", "photo": "media/vocab/stay.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/stay.mp3"}, {"word": "talk", "phonetic": "tɔːk", "levels": ["a1"], "pos": "verb", "meaning_en": "Speak words to someone.", "meaning_fa": "صحبت کردن", "example_en": "We talk on the phone every day.", "photo": "media/vocab/talk.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/talk.mp3"}, {"word": "talk to", "phonetic": "tɔːk tuː", "levels": ["a1"], "pos": "phrasal verb", "meaning_en": "Speak with someone.", "meaning_fa": "با کسی صحبت کردن", "example_en": "I need to talk to my teacher.", "photo": "media/vocab/talk-to.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/talk-to.mp3"}, {"word": "traditional", "phonetic": "trəˈdɪʃənəl", "levels": ["a2"], "pos": "adjective", "meaning_en": "Following old customs or beliefs.", "meaning_fa": "سنتی، قدیمی", "example_en": "We had a traditional wedding ceremony.", "photo": "media/vocab/traditional.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/traditional.mp3"}, {"word": "TV", "phonetic": "ˌtiːˈviː", "levels": ["a1"], "pos": "noun", "meaning_en": "A device for watching programmes with pictures and sound.", "meaning_fa": "تلویزیون", "example_en": "Let's watch TV tonight.", "photo": "media/vocab/tv.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/tv.mp3"}, {"word": "up to", "phonetic": "ʌp tuː", "levels": ["a2"], "pos": "phrase", "meaning_en": "Doing something, often something secret or bad.", "meaning_fa": "مشغول کاری بودن", "example_en": "What are you up to this weekend?", "photo": "media/vocab/up-to.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/up-to.mp3"}, {"word": "vegetable(s)", "phonetic": "ˈvedʒtəbəl", "levels": ["a1"], "pos": "noun", "meaning_en": "a plant or part of a plant used as food", "meaning_fa": "سبزیجات", "example_en": "Carrots and potatoes are vegetables.", "photo": "media/vocab/vegetables.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/vegetables.mp3"}, {"word": "video games", "phonetic": "ˈvidiːəʊ geɪmz", "levels": ["a1"], "pos": "noun", "meaning_en": "electronic games played on a screen", "meaning_fa": "بازی‌های ویدیویی", "example_en": "My brother loves playing video games.", "photo": "media/vocab/video-games.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/video-games.mp3"}, {"word": "watch", "phonetic": "wɒtʃ 4, 23, 24, watch television (TV) wɒtʃ televɪʒən", "levels": ["a1"], "pos": "verb", "meaning_en": "To look at something for a period of time.", "meaning_fa": "تماشا کردن", "example_en": "I like to watch movies on weekends.", "photo": "media/vocab/watch.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/watch.mp3"}, {"word": "watch a DVD", "phonetic": "wɒtʃ ə diːviːdiː", "levels": ["a1"], "pos": "phrase", "meaning_en": "To view a movie or show on a DVD.", "meaning_fa": "دی‌وی‌دی تماشا کردن", "example_en": "Let's watch a DVD tonight.", "photo": "media/vocab/watch-a-dvd.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/watch-a-dvd.mp3"}, {"word": "alcoholic", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Containing alcohol; related to alcohol.", "meaning_fa": "الکلی، حاوی الکل", "example_en": "They served a variety of alcoholic beverages.", "photo": "media/vocab/alcoholic.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/alcoholic.mp3"}, {"word": "amateur", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Engaging in an activity for pleasure, not professionally.", "meaning_fa": "آماتور، غیرحرفه‌ای", "example_en": "He's an amateur photographer, but his photos are stunning.", "photo": "media/vocab/amateur.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/amateur.mp3"}, {"word": "calming", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Making you feel more relaxed and less anxious.", "meaning_fa": "آرامش‌بخش", "example_en": "Listening to classical music can be very calming.", "photo": "media/vocab/calming.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/calming.mp3"}, {"word": "chocaholic", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "A person who loves and eats a lot of chocolate.", "meaning_fa": "عاشق شکلات", "example_en": "As a chocaholic, I can never resist a good bar.", "photo": "media/vocab/chocaholic.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/chocaholic.mp3"}, {"word": "chore", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "A routine task, especially a household one.", "meaning_fa": "کار روزمره، وظیفه", "example_en": "Doing laundry is my least favorite household chore.", "photo": "media/vocab/chore.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/chore.mp3"}, {"word": "couch potato", "phonetic": null, "levels": ["c1", "c2"], "pos": "idiom", "meaning_en": "A lazy person who spends much time watching TV.", "meaning_fa": "آدم تنبل، تلویزیون‌بین", "example_en": "Don't be a couch potato; let's go for a walk!", "photo": "media/vocab/couch-potato.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/couch-potato.mp3"}, {"word": "culture vulture", "phonetic": null, "levels": ["c1", "c2"], "pos": "idiom", "meaning_en": "Someone very interested in art and cultural events.", "meaning_fa": "شیفته فرهنگ و هنر", "example_en": "My aunt is a real culture vulture, always at museums.", "photo": "media/vocab/culture-vulture.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/culture-vulture.mp3"}, {"word": "dabbler", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "Someone who tries an activity without serious commitment.", "meaning_fa": "سطحی‌کار، آماتور", "example_en": "He's just a dabbler in photography, not a professional.", "photo": "media/vocab/dabbler.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/dabbler.mp3"}, {"word": "fruitful", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Producing good or useful results; productive.", "meaning_fa": "پربار، مثمر ثمر", "example_en": "Our discussion about the project was very fruitful.", "photo": "media/vocab/fruitful.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fruitful.mp3"}, {"word": "full diary", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrase", "meaning_en": "A schedule completely filled with appointments or activities.", "meaning_fa": "برنامه کاری پر", "example_en": "She has a full diary next week, no free time.", "photo": "media/vocab/full-diary.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/full-diary.mp3"}, {"word": "hooked (on)", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Addicted to something or very enthusiastic about it.", "meaning_fa": "معتاد، شیفته، گرفتار", "example_en": "I'm completely hooked on this new TV series.", "photo": "media/vocab/hooked-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hooked-on.mp3"}, {"word": "keen", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Very eager or enthusiastic about an activity.", "meaning_fa": "مشتاق، علاقه‌مند", "example_en": "She's very keen on hiking and spends weekends outdoors.", "photo": "media/vocab/keen.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/keen.mp3"}, {"word": "lawn", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "An area of mown grass in a garden.", "meaning_fa": "چمن، چمنزار", "example_en": "The children played happily on the freshly cut lawn.", "photo": "media/vocab/lawn.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/lawn.mp3"}, {"word": "lock yourself away", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To isolate oneself from others.", "meaning_fa": "خود را حبس کردن", "example_en": "He locked himself away to focus on writing his novel.", "photo": "media/vocab/lock-yourself-away.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/lock-yourself-away.mp3"}, {"word": "participant", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "A person who takes part in an activity.", "meaning_fa": "شرکت‌کننده", "example_en": "Every participant received a medal after the race.", "photo": "media/vocab/participant.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/participant.mp3"}, {"word": "relaxing", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Helping you to feel calm and less stressed.", "meaning_fa": "آرامش‌بخش", "example_en": "A warm bath is very relaxing after a long day.", "photo": "media/vocab/relaxing.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/relaxing.mp3"}, {"word": "shopaholic", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "A person who loves shopping excessively.", "meaning_fa": "خریدار افراطی", "example_en": "My sister is a real shopaholic.", "photo": "media/vocab/shopaholic.jpg", "audio": 