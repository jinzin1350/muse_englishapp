[{"word": "about", "phonetic": "əˈbaʊt", "levels": ["a1"], "pos": "preposition", "meaning_en": "on the subject of; concerning", "meaning_fa": "درباره، راجع به", "example_en": "What are you talking about?", "photo": "media/vocab/about.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/about.mp3"}, {"word": "all over [everywhere]", "phonetic": "ɔːl ˈəʊvə", "levels": ["a2"], "pos": "phrase", "meaning_en": "In every part of a place.", "meaning_fa": "همه جا، سرتاسر", "example_en": "There were toys all over the floor.", "photo": "media/vocab/all-over-everywhere.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/all-over-everywhere.mp3"}, {"word": "annual", "phonetic": "ˈænjʊəl", "levels": ["a2"], "pos": "adjective", "meaning_en": "Happening once every year.", "meaning_fa": "سالانه", "example_en": "The school has an annual sports day.", "photo": "media/vocab/annual.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/annual.mp3"}, {"word": "book", "phonetic": "bʊk", "levels": ["a1"], "pos": "noun", "meaning_en": "Pages with words and pictures, bound together.", "meaning_fa": "کتاب", "example_en": "I like to read a good book.", "photo": "media/vocab/book.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/book.mp3"}, {"word": "bring sb luck", "phonetic": "brɪŋ ˈsʌmbɒdi lʌk", "levels": ["a2"], "pos": "idiom", "meaning_en": "To cause good things to happen to someone.", "meaning_fa": "برای کسی شانس آوردن", "example_en": "This charm always brings me luck.", "photo": "media/vocab/bring-sb-luck.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/bring-sb-luck.mp3"}, {"word": "chat", "phonetic": "tʃæt", "levels": ["a1"], "pos": "verb", "meaning_en": "To talk in a friendly, informal way.", "meaning_fa": "گپ زدن، صحبت کردن", "example_en": "We chatted for an hour.", "photo": "media/vocab/chat.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/chat.mp3"}, {"word": "chat to friends online", "phonetic": "tʃæt tə frendz ˈɒnlaɪn", "levels": ["a1"], "pos": "phrase", "meaning_en": "To talk with friends using the internet.", "meaning_fa": "آنلاین با دوستان گپ زدن", "example_en": "I often chat to friends online in the evenings.", "photo": "media/vocab/chat-to-friends-online.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/chat-to-friends-online.mp3"}, {"word": "come", "phonetic": "kʌm", "levels": ["a1"], "pos": "verb", "meaning_en": "To move towards the speaker or a place.", "meaning_fa": "آمدن", "example_en": "Can you come to my party?", "photo": "media/vocab/come.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come.mp3"}, {"word": "come to", "phonetic": "kʌm tə", "levels": ["a1"], "pos": "phrasal verb", "meaning_en": "To reach a total amount.", "meaning_fa": "به مبلغی رسیدن", "example_en": "The bill came to fifty dollars.", "photo": "media/vocab/come-to.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-to.mp3"}, {"word": "comic", "phonetic": "ˈkɒmɪk", "levels": ["a1"], "pos": "noun", "meaning_en": "A magazine with stories told in pictures.", "meaning_fa": "کتاب کمیک، مجله مصور", "example_en": "My brother loves reading comic books.", "photo": "media/vocab/comic.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/comic.mp3"}, {"word": "consist of", "phonetic": "kənˈsɪst ɒv", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To be made up of certain parts.", "meaning_fa": "شامل بودن، تشکیل شدن از", "example_en": "The team consists of five players.", "photo": "media/vocab/consist-of.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/consist-of.mp3"}, {"word": "cooking", "phonetic": "ˈkʊkɪŋ", "levels": ["a1"], "pos": "noun", "meaning_en": "The activity of preparing and making food.", "meaning_fa": "آشپزی", "example_en": "Cooking is one of my favorite hobbies.", "photo": "media/vocab/cooking.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/cooking.mp3"}, {"word": "custom", "phonetic": "ˈkʌstəm", "levels": ["a2"], "pos": "noun", "meaning_en": "A traditional way of behaving or doing something.", "meaning_fa": "رسم، سنت", "example_en": "It's a local custom to give gifts.", "photo": "media/vocab/custom.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/custom.mp3"}, {"word": "customary", "phonetic": "ˈkʌstəməri", "levels": ["a2"], "pos": "adjective", "meaning_en": "Usual or traditional for a particular person or place.", "meaning_fa": "مرسوم، معمول", "example_en": "It is customary to shake hands.", "photo": "media/vocab/customary.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/customary.mp3"}, {"word": "dinner", "phonetic": "ˈdɪnə", "levels": ["a1"], "pos": "noun", "meaning_en": "The main meal of the day, often eaten in the evening.", "meaning_fa": "شام", "example_en": "What are we having for dinner tonight?", "photo": "media/vocab/dinner.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/dinner.mp3"}, {"word": "display", "phonetic": "dɪˈspleɪ", "levels": ["a2"], "pos": "verb", "meaning_en": "To show something publicly.", "meaning_fa": "نمایش دادن", "example_en": "The museum will display ancient artifacts.", "photo": "media/vocab/display.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/display.mp3"}, {"word": "do", "phonetic": "duː", "levels": ["a1"], "pos": "verb", "meaning_en": "To perform an action or activity.", "meaning_fa": "انجام دادن", "example_en": "What do you do on weekends?", "photo": "media/vocab/do.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/do.mp3"}, {"word": "do nothing", "phonetic": "duː ˈnʌθɪŋ", "levels": ["a1"], "pos": "phrase", "meaning_en": "To not do any activity.", "meaning_fa": "هیچ کاری نکردن", "example_en": "On my day off, I just want to do nothing.", "photo": "media/vocab/do-nothing.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/do-nothing.mp3"}, {"word": "download"