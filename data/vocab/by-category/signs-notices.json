[{"word": "admission", "phonetic": "ədˈmɪʃən", "levels": ["a2", "b2"], "pos": "noun", "meaning_en": "The right to enter a place or join a group.", "meaning_fa": "پذیرش، ورود", "example_en": "Admission to the museum is free.", "photo": "media/vocab/admission.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/admission.mp3"}, {"word": "alight adj, v", "phonetic": null, "levels": ["b2"], "pos": "adjective", "meaning_en": "Burning brightly; on fire.", "meaning_fa": "شعله‌ور، روشن", "example_en": "The old house was completely alight after the fire started.", "photo": "media/vocab/alight-adj-v.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/alight-adj-v.mp3"}, {"word": "auditorium", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "A large room where people watch performances.", "meaning_fa": "سالن اجتماعات/نمایش", "example_en": "The school auditorium can hold 500 students.", "photo": "media/vocab/auditorium.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/auditorium.mp3"}, {"word": "declare", "phonetic": null, "levels": ["b2"], "pos": "verb", "meaning_en": "To state something officially or publicly.", "meaning_fa": "اعلام کردن، اظهار کردن", "example_en": "You must declare all goods at customs.", "photo": "media/vocab/declare.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/declare.mp3"}, {"word": "dismount", "phonetic": null, "levels": ["b2"], "pos": "verb", "meaning_en": "To get off a horse, bicycle, or other vehicle.", "meaning_fa": "پیاده شدن، پایین آمدن", "example_en": "Please dismount your bicycle before entering the park.", "photo": "media/vocab/dismount.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/dismount.mp3"}, {"word": "display", "phonetic": "dɪˈspleɪ", "levels": ["b2"], "pos": "verb", "meaning_en": "To show something publicly.", "meaning_fa": "نمایش دادن", "example_en": "The museum will display ancient artifacts.", "photo": "media/vocab/display.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/display.mp3"}, {"word": "disturb", "phonetic": "dɪˈstɜːb", "levels": ["a2"], "pos": "verb", "meaning_en": "To interrupt someone or something.", "meaning_fa": "مزاحم شدن، مختل کردن", "example_en": "Please do not disturb the sleeping baby.", "photo": "media/vocab/disturb.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/disturb.mp3"}, {"word": "do not leave bags unattended", "phonetic": "duː nɒt liːv bægz ˌʌnəˈtendɪd", "levels": ["a2"], "pos": "phrase", "meaning_en": "Do not leave your bags alone.", "meaning_fa": "کیف‌های خود را بدون مراقب رها نکنید", "example_en": "The airport sign said, 'Do not leave bags unattended'.", "photo": "media/vocab/do-not-leave-bags-unattended.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/do-not-leave-bags-unattended.mp3"}, {"word": "entry", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "The act of going in or a place to go in.", "meaning_fa": "ورود، ورودی", "example_en": "No entry after 10 PM.", "photo": "media/vocab/entry.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/entry.mp3"}, {"word": "feed", "phonetic": "fiːd", "levels": ["a2"], "pos": "verb", "meaning_en": "To give food to a person or animal.", "meaning_fa": "غذا دادن", "example_en": "Please feed the cat before you leave.", "photo": "media/vocab/feed.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/feed.mp3"}, {"word": "fragile", "phonetic": "ˈfræʤaɪl", "levels": ["a2"], "pos": "adjective", "meaning_en": "easily broken or damaged.", "meaning_fa": "شکننده", "example_en": "Be careful, the glass is fragile.", "photo": "media/vocab/fragile.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fragile.mp3"}, {"word": "health warning", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "Official advice about dangers to health.", "meaning_fa": "هشدار بهداشتی", "example_en": "Cigarettes have a health warning on them.", "photo": "media/vocab/health-warning.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/health-warning.mp3"}, {"word": "in progress", "phonetic": "ɪn ˈprəʊgrəs", "levels": ["a2"], "pos": "phrase", "meaning_en": "Happening now, not yet finished.", "meaning_fa": "در حال انجام، در دست اقدام", "example_en": "The building work is still in progress.", "photo": "media/vocab/in-progress.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/in-progress.mp3"}, {"word": "injure", "phonetic": "ˈɪnʤə", "levels": ["a2"], "pos": "verb", "meaning_en": "To hurt yourself or someone else.", "meaning_fa": "آسیب زدن، مجروح کردن", "example_en": "Be careful not to injure yourself.", "photo": "media/vocab/injure.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/injure.mp3"}, {"word": "keep off sth", "phonetic": "kiːp ɒf ˈsʌmθɪŋ", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To stay away from something.", "meaning_fa": "دور ماندن از، نزدیک نشدن", "example_en": "Please keep off the grass.", "photo": "media/vocab/keep-off-sth.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/keep-off-sth.mp3"}, {"word": "keep right/left", "phonetic": "kiːp raɪt/left", "levels": ["a2"], "pos": "phrase", "meaning_en": "To stay on the right or left side.", "meaning_fa": "در سمت راست/چپ بمانید", "example_en": "In the UK, drivers must keep left.", "photo": "media/vocab/keep-right-left.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/keep-right-left.mp3"}, {"word": "lean", "phonetic": "liːn", "levels": ["a2"], "pos": "verb", "meaning_en": "To bend or rest against something.", "meaning_fa": "تکیه دادن", "example_en": "Don't lean on the wet paint.", "photo": "media/vocab/lean.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/lean.mp3"}, {"word": "litter", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "Rubbish left in a public place.", "meaning_fa": "زباله، آشغال", "example_en": "Please don't drop litter here.", "photo": "media/vocab/litter.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/litter.mp3"}, {"word": "mind the step", "phonetic": "maɪnd ðə step", "levels": ["a2"], "pos": "phrase", "meaning_en": "Be careful of the step.", "meaning_fa": "مراقب پله باشید", "example_en": "The sign said, \"Mind the step.\"", "photo": "media/vocab/mind-the-step.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/mind-the-step.mp3"}, {"word": "mind your head", "phonetic": "maɪnd jɔː hed", "levels": ["a2"], "pos": "phrase", "meaning_en": "Be careful not to hit your head.", "meaning_fa": "مراقب سرت باش", "example_en": "Mind your head, the ceiling is low.", "photo": "media/vocab/mind-your-head.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/mind-your-head.mp3"}, {"word": "minor", "phonetic": null, "levels": ["b2"], "pos": "adjective", "meaning_en": "Not important or serious.", "meaning_fa": "جزئی، کم اهمیت", "example_en": "It was a minor problem, easily fixed.", "photo": "media/vocab/minor.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/minor.mp3"}, {"word": "motorbike", "phonetic": "ˈməʊtəbaɪk", "levels": ["a2"], "pos": "noun", "meaning_en": "a two-wheeled vehicle with an engine", "meaning_fa": "موتورسیکلت", "example_en": "He rides his motorbike to work.", "photo": "media/vocab/motorbike.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/motorbike.mp3"}, {"word": "no entry", "phonetic": "nəʊ ˈentri", "levels": ["a2"], "pos": "phrase", "meaning_en": "You cannot go into this place.", "meaning_fa": "ورود ممنوع", "example_en": "The sign says \"No entry\" here.", "photo": "media/vocab/no-entry.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/no-entry.mp3"}, {"word": "no exit", "phonetic": "nəʊ ˈeksɪt", "levels": ["a2"], "pos": "phrase", "meaning_en": "There is no way out from this place.", "meaning_fa": "خروجی ندارد، بن‌بست", "example_en": "We are stuck; there is no exit.", "photo": "media/vocab/no-exit.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/no-exit.mp3"}, {"word": "no parking", "phonetic": "nəʊ ˈpɑːkɪŋ", "levels": ["a2"], "pos": "phrase", "meaning_en": "You cannot park your car here.", "meaning_fa": "پارک ممنوع", "example_en": "Look, there's a \"No parking\" sign.", "photo": "media/vocab/no-parking.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/no-parking.mp3"}, {"word": "no vacancies", "phonetic": "nəʊ ˈveɪkəntsiz", "levels": ["a2"], "pos": "phrase", "meaning_en": "No rooms are available in this hotel.", "meaning_fa": "اتاق خالی نداریم", "example_en": "The hotel sign said \"No vacancies.\"", "photo": "media/vocab/no-vacancies.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/no-vacancies.mp3"}, {"word": "notice n", "phonetic": "ˈnəʊtɪs", "levels": ["a2"], "pos": "noun", "meaning_en": "A written or printed announcement.", "meaning_fa": "اطلاعیه، آگهی", "example_en": "There's a notice on the wall.", "photo": "media/vocab/notice-n.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/notice-n.mp3"}, {"word": "out of order", "phonetic": "aʊt əv ˈɔːdə", "levels": ["a2"], "pos": "phrase", "meaning_en": "Not working correctly.", "meaning_fa": "خراب، از کار افتاده", "example_en": "The lift is out of order.", "photo": "media/vocab/out-of-order.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/out-of-order.mp3"}, {"word": "penalty", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "A punishment for breaking a rule or law.", "meaning_fa": "جریمه، مجازات", "example_en": "There is a penalty for late payment.", "photo": "media/vocab/penalty.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/penalty.mp3"}, {"word": "permit n", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "An official document allowing you to do something.", "meaning_fa": "مجوز، پروانه", "example_en": "You need a permit to park here.", "photo": "media/vocab/permit-n.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/permit-n.mp3"}, {"word": "personnel", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "The people who work for an organization.", "meaning_fa": "پرسنل، کارکنان", "example_en": "All personnel must wear ID badges.", "photo": "media/vocab/personnel.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/personnel.mp3"}, {"word": "prohibited", "phonetic": null, "levels": ["b2"], "pos": "adjective", "meaning_en": "Not allowed; forbidden.", "meaning_fa": "ممنوع", "example_en": "Smoking is strictly prohibited here.", "photo": "media/vocab/prohibited.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/prohibited.mp3"}, {"word": "prosecute", "phonetic": null, "levels": ["b2"], "pos": "verb", "meaning_en": "To officially accuse someone of a crime.", "meaning_fa": "تحت پیگرد قانونی قرار دادن", "example_en": "The police decided to prosecute him.", "photo": "media/vocab/prosecute.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/prosecute.mp3"}, {"word": "queue v", "phonetic": "kjuː", "levels": ["a2"], "pos": "verb", "meaning_en": "stand in a line waiting for something", "meaning_fa": "در صف ایستادن", "example_en": "Please queue here for tickets.", "photo": "media/vocab/queue-v.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/queue-v.mp3"}, {"word": "reduce", "phonetic": "rɪˈdjuːs", "levels": ["b2"], "pos": "verb", "meaning_en": "To make something smaller or less.", "meaning_fa": "کاهش دادن", "example_en": "We need to reduce our waste.", "photo": "media/vocab/reduce.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/reduce.mp3"}, {"word": "refrain", "phonetic": null, "levels": ["b2"], "pos": "verb", "meaning_en": "To stop yourself from doing something.", "meaning_fa": "خودداری کردن", "example_en": "Please refrain from smoking in this area.", "photo": "media/vocab/refrain.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/refrain.mp3"}, {"word": "serve", "phonetic": null, "levels": ["b2"], "pos": "verb", "meaning_en": "to spend time in prison as punishment", "meaning_fa": "خدمت کردن (در زندان)", "example_en": "He had to serve five years in prison.", "photo": "media/vocab/serve.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/serve.mp3"}, {"word": "silence", "phonetic": "ˈsaɪləns", "levels": ["a2"], "pos": "noun", "meaning_en": "Complete absence of sound.", "meaning_fa": "سکوت", "example_en": "Please keep silence in the library.", "photo": "media/vocab/silence.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/silence.mp3"}, {"word": "sold out", "phonetic": "səʊld aʊt", "levels": ["a2"], "pos": "adjective phrase", "meaning_en": "All tickets or items are gone.", "meaning_fa": "تمام شد، فروخته شد", "example_en": "The concert tickets are sold out.", "photo": "media/vocab/sold-out.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/sold-out.mp3"}, {"word": "trespasser", "phonetic": null, "levels": ["b2"], "pos": "noun", "meaning_en": "Someone who goes onto private land without permission.", "meaning_fa": "متجاوز، واردشونده غیرمجاز", "example_en": "A sign warned trespassers to stay off the property.", "photo": "media/vocab/trespasser.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/trespasser.mp3"}, {"word": "unaccompanied", "phonetic": null, "levels": ["b2"], "pos": "adjective", "meaning_en": "Not with another person or people.", "meaning_fa": "بدون همراه، تنها", "example_en": "Children under 12 must be accompanied.", "photo": "media/vocab/unaccompanied.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/unaccompanied.mp3"}, {"word": "unauthorised", "phonetic": null, "levels": ["b2"], "pos": "adjective", "meaning_en": "Not allowed by official permission.", "meaning_fa": "غیرمجاز، بدون اجازه", "example_en": "Do not enter this area; it is unauthorised.", "photo": "media/vocab/unauthorised.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/unauthorised.mp3"}, {"word": "vehicle", "phonetic": "ˈviəkəl", "levels": ["b2"], "pos": "noun", "meaning_en": "a machine that transports people or goods", "meaning_fa": "وسیله نقلیه", "example_en": "A car is a type of vehicle.", "photo": "media/vocab/vehicle.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/vehicle.mp3"}, {"word": "warning", "phonetic": "ˈwɔːnɪŋ", "levels": ["a2"], "pos": "noun", "meaning_en": "A statement telling you about a possible danger.", "meaning_fa": "هشدار", "example_en": "The sign gave a warning about falling rocks.", "photo": "media/vocab/warning.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/warning.mp3"}]