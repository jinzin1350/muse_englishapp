[{"word": "a bit [slightly]", "phonetic": "ə bɪt", "levels": ["b1"], "pos": "adverb", "meaning_en": "a little, to a small degree", "meaning_fa": "کمی، اندکی", "example_en": "I'm feeling a bit tired today.", "photo": "media/vocab/a-bit-slightly.jpg"}, {"word": "a little (bit)", "phonetic": "ə ˈlɪtəl", "levels": ["b1"], "pos": "adverb", "meaning_en": "a small amount or degree", "meaning_fa": "کمی، اندکی", "example_en": "Can I have a little bit of water, please?", "photo": "media/vocab/a-little-bit.jpg"}, {"word": "angrily", "phonetic": "ˈæŋgrɪli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In an angry way.", "meaning_fa": "با عصبانیت", "example_en": "She shouted angrily at her brother.", "photo": "media/vocab/angrily.jpg"}, {"word": "bad", "phonetic": "bæd", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not good; unpleasant or harmful.", "meaning_fa": "بد، ناپسند", "example_en": "The weather was really bad yesterday.", "photo": "media/vocab/bad.jpg"}, {"word": "badly", "phonetic": "ˈbædli", "levels": ["a2"], "pos": "adverb", "meaning_en": "In a poor or unsatisfactory way.", "meaning_fa": "بد، به طرز بدی", "example_en": "He sings badly, but he loves it.", "photo": "media/vocab/badly.jpg"}, {"word": "briefly", "phonetic": "ˈbriːfli", "levels": ["b1"], "pos": "adverb", "meaning_en": "For a short time; in a few words.", "meaning_fa": "به طور خلاصه، برای مدت کوتاه", "example_en": "He spoke briefly about his trip.", "photo": "media/vocab/briefly.jpg"}, {"word": "completely", "phonetic": "kəmˈpliːtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In every way; totally.", "meaning_fa": "کاملاً، تماماً", "example_en": "I completely forgot about the meeting.", "photo": "media/vocab/completely.jpg"}, {"word": "degree [amount]", "phonetic": "dɪˈgriː", "levels": ["b1"], "pos": "noun", "meaning_en": "A level or amount of something.", "meaning_fa": "میزان، درجه", "example_en": "There was a high degree of difficulty in the exam.", "photo": "media/vocab/degree-amount.jpg"}, {"word": "extremely", "phonetic": "ɪkˈstriːmli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Very, very much.", "meaning_fa": "بسیار، فوق‌العاده", "example_en": "It was extremely cold last night.", "photo": "media/vocab/extremely.jpg"}, {"word": "fairly", "phonetic": "ˈfeəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "More than a little, but less than very.", "meaning_fa": "نسبتاً، تا حدی", "example_en": "The movie was fairly good.", "photo": "media/vocab/fairly.jpg"}, {"word": "fast", "phonetic": "fɑːst", "levels": ["a2"], "pos": "adverb", "meaning_en": "Moving or happening quickly.", "meaning_fa": "سریع، تند", "example_en": "He can run very fast.", "photo": "media/vocab/fast.jpg"}, {"word": "frequency", "phonetic": "ˈfriːkwəntsi", "levels": ["b1"], "pos": "noun", "meaning_en": "how often something happens.", "meaning_fa": "بسامد، تکرار", "example_en": "What is the frequency of these buses?", "photo": "media/vocab/frequency.jpg"}, {"word": "frequently", "phonetic": "ˈfriːkwəntli", "levels": ["b1"], "pos": "adverb", "meaning_en": "often.", "meaning_fa": "اغلب، مکرراً", "example_en": "He frequently visits his grandparents.", "photo": "media/vocab/frequently.jpg"}, {"word": "friendly", "phonetic": "ˈfrendli", "levels": ["a2"], "pos": "adjective", "meaning_en": "kind and pleasant.", "meaning_fa": "دوستانه، صمیمی", "example_en": "He has a friendly dog.", "photo": "media/vocab/friendly.jpg"}, {"word": "good", "phonetic": "gʊd", "levels": ["a2"], "pos": "adjective", "meaning_en": "Of high quality or standard.", "meaning_fa": "خوب", "example_en": "This is a very good book.", "photo": "media/vocab/good.jpg"}, {"word": "hardly ever", "phonetic": "ˈhɑːdli ˈevə", "levels": ["b1"], "pos": "adverb phrase", "meaning_en": "Almost never.", "meaning_fa": "به ندرت، تقریباً هرگز", "example_en": "I hardly ever eat fast food.", "photo": "media/vocab/hardly-ever.jpg"}, {"word": "incredibly", "phonetic": "ɪnˈkredɪbli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Extremely or surprisingly.", "meaning_fa": "به طرز باورنکردنی، فوق‌العاده", "example_en": "The view from the mountain was incredibly beautiful.", "photo": "media/vocab/incredibly.jpg"}, {"word": "loud", "phonetic": "laʊd", "levels": ["a2"], "pos": "adjective", "meaning_en": "making a lot of noise.", "meaning_fa": "بلند، پر سر و صدا", "example_en": "The music was too loud.", "photo": "media/vocab/loud.jpg"}, {"word": "loudly", "phonetic": "ˈlaʊdli", "levels": ["a2"], "pos": "adverb", "meaning_en": "in a way that makes a lot of noise.", "meaning_fa": "با صدای بلند", "example_en": "He spoke loudly so everyone could hear.", "photo": "media/vocab/loudly.jpg"}, {"word": "manner", "phonetic": "ˈmænə", "levels": ["a2"], "pos": "noun", "meaning_en": "The way something is done or happens.", "meaning_fa": "روش، شیوه", "example_en": "She spoke in a polite manner.", "photo": "media/vocab/manner.jpg"}, {"word": "occasionally", "phonetic": "əˈkeɪʒnəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Sometimes, but not often.", "meaning_fa": "گهگاه، بعضی اوقات", "example_en": "I occasionally eat fast food.", "photo": "media/vocab/occasionally.jpg"}, {"word": "politely", "phonetic": "pəˈlaɪtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In a polite way.", "meaning_fa": "مودبانه", "example_en": "He asked politely for help.", "photo": "media/vocab/politely.jpg"}, {"word": "pretty [rather]", "phonetic": "ˈprɪti", "levels": ["b1"], "pos": "adverb", "meaning_en": "Quite, to a fair degree.", "meaning_fa": "نسبتاً، تاحدی", "example_en": "It's pretty cold outside today.", "photo": "media/vocab/pretty-rather.jpg"}, {"word": "quiet", "phonetic": "ˈkwaɪət", "levels": ["a2"], "pos": "adjective", "meaning_en": "making little or no noise", "meaning_fa": "آرام، ساکت", "example_en": "The library is a very quiet place.", "photo": "media/vocab/quiet.jpg"}, {"word": "quietly", "phonetic": "ˈkwaɪətli", "levels": ["a2", "b1"], "pos": "adverb", "meaning_en": "making little noise", "meaning_fa": "به آرامی، بی سر و صدا", "example_en": "She closed the door quietly.", "photo": "media/vocab/quietly.jpg"}, {"word": "quite", "phonetic": "kwaɪt", "levels": ["b1"], "pos": "adverb", "meaning_en": "a little or a lot, but not completely", "meaning_fa": "نسبتاً، کاملاً", "example_en": "The film was quite good.", "photo": "media/vocab/quite.jpg"}, {"word": "quite often", "phonetic": "kwaɪt ˈɒfən", "levels": ["b1"], "pos": "phrase", "meaning_en": "many times, frequently", "meaning_fa": "اغلب، خیلی وقت‌ها", "example_en": "We go to the park quite often.", "photo": "media/vocab/quite-often.jpg"}, {"word": "rarely", "phonetic": "ˈreəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "not often, almost never", "meaning_fa": "به ندرت، کم پیش می‌آید", "example_en": "I rarely eat fast food.", "photo": "media/vocab/rarely.jpg"}, {"word": "rather", "phonetic": "ˈrɑːðə", "levels": ["b1"], "pos": "adverb", "meaning_en": "quite, to some degree", "meaning_fa": "نسبتاً، تا حدی", "example_en": "It's rather cold today.", "photo": "media/vocab/rather.jpg"}, {"word": "right", "phonetic": "raɪt", "levels": ["a2"], "pos": "adverb", "meaning_en": "On the side that is not left.", "meaning_fa": "راست، سمت راست", "example_en": "Turn right at the traffic lights.", "photo": "media/vocab/right.jpg"}, {"word": "right way", "phonetic": "raɪt wei", "levels": ["a2"], "pos": "noun phrase", "meaning_en": "The correct or proper method.", "meaning_fa": "راه درست", "example_en": "Please show me the right way to do it.", "photo": "media/vocab/right-way.jpg"}, {"word": "seldom", "phonetic": "ˈseldəm", "levels": ["b1"], "pos": "adverb", "meaning_en": "Not often; rarely.", "meaning_fa": "به ندرت", "example_en": "We seldom go out on weekdays.", "photo": "media/vocab/seldom.jpg"}, {"word": "slightly", "phonetic": "ˈslaɪtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "A little bit.", "meaning_fa": "کمی، اندکی", "example_en": "The weather is slightly warmer today.", "photo": "media/vocab/slightly.jpg"}, {"word": "slow", "phonetic": "sləʊ", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not fast.", "meaning_fa": "آهسته، کند", "example_en": "The internet is very slow.", "photo": "media/vocab/slow.jpg"}, {"word": "slowly", "phonetic": "ˈsləʊli", "levels": ["a2"], "pos": "adverb", "meaning_en": "At a slow speed.", "meaning_fa": "به آرامی، آهسته", "example_en": "He walked slowly to the door.", "photo": "media/vocab/slowly.jpg"}, {"word": "suddenly", "phonetic": "ˈsʌdənli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Happening quickly and unexpectedly.", "meaning_fa": "ناگهان، به طور ناگهانی", "example_en": "The car stopped suddenly in front of us.", "photo": "media/vocab/suddenly.jpg"}, {"word": "totally", "phonetic": "ˈtəʊtəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Completely; absolutely.", "meaning_fa": "کاملاً، تماماً", "example_en": "I totally agree with your idea.", "photo": "media/vocab/totally.jpg"}, {"word": "unfriendly (way)", "phonetic": "ʌnˈfrendli", "levels": ["a2"], "pos": "adverb", "meaning_en": "In a way that is not kind or pleasant.", "meaning_fa": "به طور غیردوستانه", "example_en": "He spoke to me in an unfriendly way.", "photo": "media/vocab/unfriendly-way.jpg"}, {"word": "urgently", "phonetic": "ˈɜːʤəntli", "levels": ["b1"], "pos": "adverb", "meaning_en": "in a way that needs immediate attention", "meaning_fa": "فوراً، با عجله", "example_en": "We need to leave urgently.", "photo": "media/vocab/urgently.jpg"}, {"word": "way", "phonetic": "weɪ", "levels": ["a2"], "pos": "noun", "meaning_en": "A method or style of doing something.", "meaning_fa": "روش، شیوه", "example_en": "I like the way you sing.", "photo": "media/vocab/way.jpg"}, {"word": "well", "phonetic": "wel", "levels": ["a2"], "pos": "adjective", "meaning_en": "Healthy; not sick.", "meaning_fa": "خوب، سالم", "example_en": "I feel very well today.", "photo": "media/vocab/well.jpg"}, {"word": "wrong (way)", "phonetic": "rɒŋ", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not correct; mistaken.", "meaning_fa": "اشتباه، غلط", "example_en": "You are going the wrong way.", "photo": "media/vocab/wrong-way.jpg"}]