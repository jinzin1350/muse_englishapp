[{"word": "a bit [slightly]", "phonetic": "ə bɪt", "levels": ["b1"], "pos": "adverb", "meaning_en": "a little, to a small degree", "meaning_fa": "کمی، اندکی", "example_en": "I'm feeling a bit tired today.", "photo": "media/vocab/a-bit-slightly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/a-bit-slightly.mp3"}, {"word": "a little (bit)", "phonetic": "ə ˈlɪtəl", "levels": ["b1"], "pos": "adverb", "meaning_en": "a small amount or degree", "meaning_fa": "کمی، اندکی", "example_en": "Can I have a little bit of water, please?", "photo": "media/vocab/a-little-bit.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/a-little-bit.mp3"}, {"word": "angrily", "phonetic": "ˈæŋgrɪli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In an angry way.", "meaning_fa": "با عصبانیت", "example_en": "She shouted angrily at her brother.", "photo": "media/vocab/angrily.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/angrily.mp3"}, {"word": "bad", "phonetic": "bæd", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not good; unpleasant or harmful.", "meaning_fa": "بد، ناپسند", "example_en": "The weather was really bad yesterday.", "photo": "media/vocab/bad.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/bad.mp3"}, {"word": "badly", "phonetic": "ˈbædli", "levels": ["a2"], "pos": "adverb", "meaning_en": "In a poor or unsatisfactory way.", "meaning_fa": "بد، به طرز بدی", "example_en": "He sings badly, but he loves it.", "photo": "media/vocab/badly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/badly.mp3"}, {"word": "briefly", "phonetic": "ˈbriːfli", "levels": ["b1"], "pos": "adverb", "meaning_en": "For a short time; in a few words.", "meaning_fa": "به طور خلاصه، برای مدت کوتاه", "example_en": "He spoke briefly about his trip.", "photo": "media/vocab/briefly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/briefly.mp3"}, {"word": "completely", "phonetic": "kəmˈpliːtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In every way; totally.", "meaning_fa": "کاملاً، تماماً", "example_en": "I completely forgot about the meeting.", "photo": "media/vocab/completely.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/completely.mp3"}, {"word": "degree [amount]", "phonetic": "dɪˈgriː", "levels": ["b1"], "pos": "noun", "meaning_en": "A level or amount of something.", "meaning_fa": "میزان، درجه", "example_en": "There was a high degree of difficulty in the exam.", "photo": "media/vocab/degree-amount.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/degree-amount.mp3"}, {"word": "extremely", "phonetic": "ɪkˈstriːmli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Very, very much.", "meaning_fa": "بسیار، فوق‌العاده", "example_en": "It was extremely cold last night.", "photo": "media/vocab/extremely.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/extremely.mp3"}, {"word": "fairly", "phonetic": "ˈfeəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "More than a little, but less than very.", "meaning_fa": "نسبتاً، تا حدی", "example_en": "The movie was fairly good.", "photo": "media/vocab/fairly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fairly.mp3"}, {"word": "fast", "phonetic": "fɑːst", "levels": ["a2"], "pos": "adverb", "meaning_en": "Moving or happening quickly.", "meaning_fa": "سریع، تند", "example_en": "He can run very fast.", "photo": "media/vocab/fast.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fast.mp3"}, {"word": "frequency", "phonetic": "ˈfriːkwəntsi", "levels": ["b1"], "pos": "noun", "meaning_en": "how often something happens.", "meaning_fa": "بسامد، تکرار", "example_en": "What is the frequency of these buses?", "photo": "media/vocab/frequency.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/frequency.mp3"}, {"word": "frequently", "phonetic": "ˈfriːkwəntli", "levels": ["b1"], "pos": "adverb", "meaning_en": "often.", "meaning_fa": "اغلب، مکرراً", "example_en": "He frequently visits his grandparents.", "photo": "media/vocab/frequently.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/frequently.mp3"}, {"word": "friendly", "phonetic": "ˈfrendli", "levels": ["a2"], "pos": "adjective", "meaning_en": "kind and pleasant.", "meaning_fa": "دوستانه، صمیمی", "example_en": "He has a friendly dog.", "photo": "media/vocab/friendly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/friendly.mp3"}, {"word": "good", "phonetic": "gʊd", "levels": ["a2"], "pos": "adjective", "meaning_en": "Of high quality or standard.", "meaning_fa": "خوب", "example_en": "This is a very good book.", "photo": "media/vocab/good.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/good.mp3"}, {"word": "hardly ever", "phonetic": "ˈhɑːdli ˈevə", "levels": ["b1"], "pos": "adverb phrase", "meaning_en": "Almost never.", "meaning_fa": "به ندرت، تقریباً هرگز", "example_en": "I hardly ever eat fast food.", "photo": "media/vocab/hardly-ever.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hardly-ever.mp3"}, {"word": "incredibly", "phonetic": "ɪnˈkredɪbli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Extremely or surprisingly.", "meaning_fa": "به طرز باورنکردنی، فوق‌العاده", "example_en": "The view from the mountain was incredibly beautiful.", "photo": "media/vocab/incredibly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/incredibly.mp3"}, {"word": "loud", "phonetic": "laʊd", "levels": ["a2"], "pos": "adjective", "meaning_en": "making a lot of noise.", "meaning_fa": "بلند، پر سر و صدا", "example_en": "The music was too loud.", "photo": "media/vocab/loud.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/loud.mp3"}, {"word": "loudly", "phonetic": "ˈlaʊdli", "levels": ["a2"], "pos": "adverb", "meaning_en": "in a way that makes a lot of noise.", "meaning_fa": "با صدای بلند", "example_en": "He spoke loudly so everyone could hear.", "photo": "media/vocab/loudly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/loudly.mp3"}, {"word": "manner", "phonetic": "ˈmænə", "levels": ["a2"], "pos": "noun", "meaning_en": "The way something is done or happens.", "meaning_fa": "روش، شیوه", "example_en": "She spoke in a polite manner.", "photo": "media/vocab/manner.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/manner.mp3"}, {"word": "occasionally", "phonetic": "əˈkeɪʒnəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Sometimes, but not often.", "meaning_fa": "گهگاه، بعضی اوقات", "example_en": "I occasionally eat fast food.", "photo": "media/vocab/occasionally.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/occasionally.mp3"}, {"word": "politely", "phonetic": "pəˈlaɪtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "In a polite way.", "meaning_fa": "مودبانه", "example_en": "He asked politely for help.", "photo": "media/vocab/politely.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/politely.mp3"}, {"word": "pretty [rather]", "phonetic": "ˈprɪti", "levels": ["b1"], "pos": "adverb", "meaning_en": "Quite, to a fair degree.", "meaning_fa": "نسبتاً، تاحدی", "example_en": "It's pretty cold outside today.", "photo": "media/vocab/pretty-rather.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/pretty-rather.mp3"}, {"word": "quiet", "phonetic": "ˈkwaɪət", "levels": ["a2"], "pos": "adjective", "meaning_en": "making little or no noise", "meaning_fa": "آرام، ساکت", "example_en": "The library is a very quiet place.", "photo": "media/vocab/quiet.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/quiet.mp3"}, {"word": "quietly", "phonetic": "ˈkwaɪətli", "levels": ["a2", "b1"], "pos": "adverb", "meaning_en": "making little noise", "meaning_fa": "به آرامی، بی سر و صدا", "example_en": "She closed the door quietly.", "photo": "media/vocab/quietly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/quietly.mp3"}, {"word": "quite", "phonetic": "kwaɪt", "levels": ["b1"], "pos": "adverb", "meaning_en": "a little or a lot, but not completely", "meaning_fa": "نسبتاً، کاملاً", "example_en": "The film was quite good.", "photo": "media/vocab/quite.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/quite.mp3"}, {"word": "quite often", "phonetic": "kwaɪt ˈɒfən", "levels": ["b1"], "pos": "phrase", "meaning_en": "many times, frequently", "meaning_fa": "اغلب، خیلی وقت‌ها", "example_en": "We go to the park quite often.", "photo": "media/vocab/quite-often.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/quite-often.mp3"}, {"word": "rarely", "phonetic": "ˈreəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "not often, almost never", "meaning_fa": "به ندرت، کم پیش می‌آید", "example_en": "I rarely eat fast food.", "photo": "media/vocab/rarely.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/rarely.mp3"}, {"word": "rather", "phonetic": "ˈrɑːðə", "levels": ["b1"], "pos": "adverb", "meaning_en": "quite, to some degree", "meaning_fa": "نسبتاً، تا حدی", "example_en": "It's rather cold today.", "photo": "media/vocab/rather.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/rather.mp3"}, {"word": "right", "phonetic": "raɪt", "levels": ["a2"], "pos": "adverb", "meaning_en": "On the side that is not left.", "meaning_fa": "راست، سمت راست", "example_en": "Turn right at the traffic lights.", "photo": "media/vocab/right.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/right.mp3"}, {"word": "right way", "phonetic": "raɪt wei", "levels": ["a2"], "pos": "noun phrase", "meaning_en": "The correct or proper method.", "meaning_fa": "راه درست", "example_en": "Please show me the right way to do it.", "photo": "media/vocab/right-way.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/right-way.mp3"}, {"word": "seldom", "phonetic": "ˈseldəm", "levels": ["b1"], "pos": "adverb", "meaning_en": "Not often; rarely.", "meaning_fa": "به ندرت", "example_en": "We seldom go out on weekdays.", "photo": "media/vocab/seldom.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/seldom.mp3"}, {"word": "slightly", "phonetic": "ˈslaɪtli", "levels": ["b1"], "pos": "adverb", "meaning_en": "A little bit.", "meaning_fa": "کمی، اندکی", "example_en": "The weather is slightly warmer today.", "photo": "media/vocab/slightly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/slightly.mp3"}, {"word": "slow", "phonetic": "sləʊ", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not fast.", "meaning_fa": "آهسته، کند", "example_en": "The internet is very slow.", "photo": "media/vocab/slow.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/slow.mp3"}, {"word": "slowly", "phonetic": "ˈsləʊli", "levels": ["a2"], "pos": "adverb", "meaning_en": "At a slow speed.", "meaning_fa": "به آرامی، آهسته", "example_en": "He walked slowly to the door.", "photo": "media/vocab/slowly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/slowly.mp3"}, {"word": "suddenly", "phonetic": "ˈsʌdənli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Happening quickly and unexpectedly.", "meaning_fa": "ناگهان، به طور ناگهانی", "example_en": "The car stopped suddenly in front of us.", "photo": "media/vocab/suddenly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/suddenly.mp3"}, {"word": "totally", "phonetic": "ˈtəʊtəli", "levels": ["b1"], "pos": "adverb", "meaning_en": "Completely; absolutely.", "meaning_fa": "کاملاً، تماماً", "example_en": "I totally agree with your idea.", "photo": "media/vocab/totally.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/totally.mp3"}, {"word": "unfriendly (way)", "phonetic": "ʌnˈfrendli", "levels": ["a2"], "pos": "adverb", "meaning_en": "In a way that is not kind or pleasant.", "meaning_fa": "به طور غیردوستانه", "example_en": "He spoke to me in an unfriendly way.", "photo": "media/vocab/unfriendly-way.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/unfriendly-way.mp3"}, {"word": "urgently", "phonetic": "ˈɜːʤəntli", "levels": ["b1"], "pos": "adverb", "meaning_en": "in a way that needs immediate attention", "meaning_fa": "فوراً، با عجله", "example_en": "We need to leave urgently.", "photo": "media/vocab/urgently.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/urgently.mp3"}, {"word": "way", "phonetic": "weɪ", "levels": ["a2"], "pos": "noun", "meaning_en": "A method or style of doing something.", "meaning_fa": "روش، شیوه", "example_en": "I like the way you sing.", "photo": "media/vocab/way.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/way.mp3"}, {"word": "well", "phonetic": "wel", "levels": ["a2"], "pos": "adjective", "meaning_en": "Healthy; not sick.", "meaning_fa": "خوب، سالم", "example_en": "I feel very well today.", "photo": "media/vocab/well.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/well.mp3"}, {"word": "wrong (way)", "phonetic": "rɒŋ", "levels": ["a2"], "pos": "adjective", "meaning_en": "Not correct; mistaken.", "meaning_fa": "اشتباه، غلط", "example_en": "You are going the wrong way.", "photo": "media/vocab/wrong-way.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/wrong-way.mp3"}, {"word": "courtesy", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "The showing of politeness in one's attitude.", "meaning_fa": "ادب، نزاکت", "example_en": "He always treats his colleagues with courtesy.", "photo": "media/vocab/courtesy.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/courtesy.mp3"}, {"word": "the done thing", "phonetic": null, "levels": ["c1", "c2"], "pos": "idiom", "meaning_en": "The socially acceptable or expected way of behaving.", "meaning_fa": "کار درست، رسم معمول", "example_en": "It's the done thing to send a thank-you note.", "photo": "media/vocab/the-done-thing.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/the-done-thing.mp3"}, {"word": "etiquette", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "The customary code of polite behavior in society.", "meaning_fa": "آداب معاشرت", "example_en": "Dining etiquette varies greatly across cultures.", "photo": "media/vocab/etiquette.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/etiquette.mp3"}, {"word": "flinch", "phonetic": null, "levels": ["c1", "c2"], "pos": "verb", "meaning_en": "To make a quick, nervous movement as from pain or fear.", "meaning_fa": "جا خوردن، عقب کشیدن", "example_en": "He didn't flinch even when the loud noise startled everyone.", "photo": "media/vocab/flinch.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/flinch.mp3"}, {"word": "insolent", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Showing a rude and arrogant lack of respect.", "meaning_fa": "گستاخ، بی‌ادب", "example_en": "The student's insolent remarks angered the teacher.", "photo": "media/vocab/insolent.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/insolent.mp3"}, {"word": "manners", "phonetic": null, "levels": ["c1", "c2"], "pos": "plural noun", "meaning_en": "Polite ways of behaving in social situations.", "meaning_fa": "آداب معاشرت، نزاکت", "example_en": "Good manners are essential when dining out.", "photo": "media/vocab/manners.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/manners.mp3"}, {"word": "netiquette", "phonetic": null, "levels": ["c1", "c2"], "pos": "noun", "meaning_en": "The correct or acceptable way of communicating online.", "meaning_fa": "آداب معاشرت آنلاین", "example_en": "Good netiquette includes not typing in all caps.", "photo": "media/vocab/netiquette.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/netiquette.mp3"}, {"word": "raise your eyebrows", "phonetic": null, "levels": ["c1", "c2"], "pos": "idiom", "meaning_en": "Show surprise or disapproval by lifting your eyebrows.", "meaning_fa": "ابرو بالا انداختن", "example_en": "His unusual suggestion made everyone raise their eyebrows.", "photo": "media/vocab/raise-your-eyebrows.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/raise-your-eyebrows.mp3"}, {"word": "smirk", "phonetic": null, "levels": ["c1", "c2"], "pos": "verb", "meaning_en": "To smile in an arrogant or self-satisfied way.", "meaning_fa": "پوزخند زدن", "example_en": "He smirked when he heard the news.", "photo": "media/vocab/smirk.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/smirk.mp3"}, {"word": "sniff at something", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To show disapproval or disdain for something.", "meaning_fa": "تحقیر کردن، بی‌اعتنایی کردن", "example_en": "She wouldn't sniff at a free meal.", "photo": "media/vocab/sniff-at-something.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/sniff-at-something.mp3"}, {"word": "snort", "phonetic": null, "levels": ["c1", "c2"], "pos": "verb", "meaning_en": "Make a loud sound by forcing air through nose.", "meaning_fa": "فین فین کردن، خرناس کشیدن", "example_en": "The horse snorted loudly, sensing danger nearby.", "photo": "media/vocab/snort.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/snort.mp3"}, {"word": "squirm", "phonetic": null, "levels": ["c1", "c2"], "pos": "verb", "meaning_en": "To wriggle or twist body movements, often from discomfort.", "meaning_fa": "وول خوردن، پیچ و تاب خوردن", "example_en": "The child squirmed uncomfortably in his seat.", "photo": "media/vocab/squirm.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/squirm.mp3"}, {"word": "stand on ceremony", "phonetic": null, "levels": ["c1", "c2"], "pos": "idiom", "meaning_en": "To insist on formal behavior or etiquette.", "meaning_fa": "تعارف کردن، تشریفات را رعایت کردن", "example_en": "Please don't stand on ceremony; just make yourself at home.", "photo": "media/vocab/stand-on-ceremony.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/stand-on-ceremony.mp3"}, {"word": "straitlaced", "phonetic": null, "levels": ["c1", "c2"], "pos": "adjective", "meaning_en": "Having very strict moral attitudes and conventional behavior.", "meaning_fa": "خشک، متعصب، مقید", "example_en": "His straitlaced parents disapproved of his tattoos.", "photo": "media/vocab/straitlaced.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/straitlaced.mp3"}, {"word": "titter", "phonetic": null, "levels": ["c1", "c2"], "pos": "verb", "meaning_en": "Laugh quietly and nervously.", "meaning_fa": "ریز خندیدن", "example_en": "The students began to titter when the teacher stumbled.", "photo": "media/vocab/titter.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/titter.mp3"}]