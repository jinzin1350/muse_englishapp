[{"word": "break down", "phonetic": "breɪk daʊn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To stop working (for a machine or vehicle).", "meaning_fa": "خراب شدن، از کار افتادن", "example_en": "My car broke down on the way to work.", "photo": "media/vocab/break-down.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/break-down.mp3"}, {"word": "break in(to sth)", "phonetic": "breɪk ɪn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To enter a building illegally, often by force.", "meaning_fa": "به زور وارد شدن، سرقت کردن", "example_en": "Someone tried to break into the house last night.", "photo": "media/vocab/break-into-sth.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/break-into-sth.mp3"}, {"word": "call for sb", "phonetic": "kɔːl fɔː sʌmbɒdi", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To ask someone to come to a place.", "meaning_fa": "دنبال کسی رفتن", "example_en": "I will call for you at 7 PM.", "photo": "media/vocab/call-for-sb.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/call-for-sb.mp3"}, {"word": "carry on (with sth)", "phonetic": "ˈkæri ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To continue doing something.", "meaning_fa": "ادامه دادن", "example_en": "Please carry on with your work.", "photo": "media/vocab/carry-on-with-sth.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/carry-on-with-sth.mp3"}, {"word": "come on", "phonetic": "kʌm ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "Used to encourage someone or hurry them.", "meaning_fa": "عجله کن، بیا", "example_en": "Come on, we're going to be late!", "photo": "media/vocab/come-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-on.mp3"}, {"word": "fall over", "phonetic": "fɔːl ˈəʊvə", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To lose your balance and drop to the ground.", "meaning_fa": "افتادن، سرنگون شدن", "example_en": "The child ran too fast and fell over.", "photo": "media/vocab/fall-over.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fall-over.mp3"}, {"word": "find out", "phonetic": "faɪnd aʊt", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To discover a fact or piece of information.", "meaning_fa": "کشف کردن، فهمیدن", "example_en": "I need to find out when the train leaves.", "photo": "media/vocab/find-out.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/find-out.mp3"}, {"word": "get in [arrive]", "phonetic": "get ɪn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "to arrive at a place, especially home.", "meaning_fa": "رسیدن (به خانه)", "example_en": "What time did you get in last night?", "photo": "media/vocab/get-in-arrive.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-in-arrive.mp3"}, {"word": "get off get", "phonetic": "ɒf", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "to leave work or school.", "meaning_fa": "تعطیل شدن، مرخص شدن", "example_en": "What time do you get off work?", "photo": "media/vocab/get-off-get.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-off-get.mp3"}, {"word": "get on (with sb) get", "phonetic": "ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "to have a good relationship with someone.", "meaning_fa": "با کسی کنار آمدن", "example_en": "I get on well with my colleagues.", "photo": "media/vocab/get-on-with-sb-get.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-on-with-sb-get.mp3"}, {"word": "get on get", "phonetic": "ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "to make progress or manage a situation.", "meaning_fa": "پیشرفت کردن، اداره کردن", "example_en": "How are you getting on with your homework?", "photo": "media/vocab/get-on-get.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-on-get.mp3"}, {"word": "get over sth get", "phonetic": "ˈəʊvə ˈsʌmθɪŋ", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Recover from an illness or a bad feeling.", "meaning_fa": "بهبود یافتن، فراموش کردن", "example_en": "She needs time to get over her cold.", "photo": "media/vocab/get-over-sth-get.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-over-sth-get.mp3"}, {"word": "get up get", "phonetic": "ʌp", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "Get out of bed.", "meaning_fa": "از خواب بیدار شدن", "example_en": "I get up at 7 AM every day.", "photo": "media/vocab/get-up-get.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/get-up-get.mp3"}, {"word": "give sth away", "phonetic": "gɪv ˈsʌmθɪŋ əˈweɪ", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Give something to someone for free.", "meaning_fa": "اهدا کردن، بخشیدن", "example_en": "I'm going to give away my old books.", "photo": "media/vocab/give-sth-away.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/give-sth-away.mp3"}, {"word": "give up (sth) [stop doing an activity]", "phonetic": "gɪv ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Stop trying to do something.", "meaning_fa": "دست کشیدن، رها کردن", "example_en": "Don't give up on your dreams.", "photo": "media/vocab/give-up-sth-stop-doing-an-activity.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/give-up-sth-stop-doing-an-activity.mp3"}, {"word": "go away [go on holiday]", "phonetic": "gəʊ əˈweɪ", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To leave your home for a holiday.", "meaning_fa": "به تعطیلات رفتن", "example_en": "We want to go away for a week in summer.", "photo": "media/vocab/go-away-go-on-holiday.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-away-go-on-holiday.mp3"}, {"word": "go away [leave]", "phonetic": "gəʊ əˈweɪ", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To leave a place or person.", "meaning_fa": "ترک کردن، رفتن", "example_en": "Please go away and leave me alone.", "photo": "media/vocab/go-away-leave.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-away-leave.mp3"}, {"word": "go back", "phonetic": "gəʊ bæk", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To return to a place or time.", "meaning_fa": "بازگشتن", "example_en": "I need to go back home now.", "photo": "media/vocab/go-back.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-back.mp3"}, {"word": "go off", "phonetic": "gəʊ ɒf", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To leave a place, often suddenly.", "meaning_fa": "ترک کردن", "example_en": "He went off without saying goodbye.", "photo": "media/vocab/go-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-off.mp3"}, {"word": "go off [electricity]", "phonetic": "gəʊ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To stop working, usually for electricity or power.", "meaning_fa": "قطع شدن (برق)", "example_en": "The electricity went off during the storm.", "photo": "media/vocab/go-off-electricity.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-off-electricity.mp3"}, {"word": "go off [explode]", "phonetic": "gəʊ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To explode or fire, like a bomb or gun.", "meaning_fa": "منفجر شدن", "example_en": "The bomb went off in the city center.", "photo": "media/vocab/go-off-explode.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-off-explode.mp3"}, {"word": "go off [go bad]", "phonetic": "gəʊ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Food or drink becomes bad and cannot be eaten.", "meaning_fa": "فاسد شدن (غذا)", "example_en": "Don't eat that milk; it has gone off.", "photo": "media/vocab/go-off-go-bad.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-off-go-bad.mp3"}, {"word": "go off [ring]", "phonetic": "gəʊ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To make a sudden loud noise, like an alarm.", "meaning_fa": "زنگ زدن (ساعت)", "example_en": "My alarm clock goes off at 6 AM.", "photo": "media/vocab/go-off-ring.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-off-ring.mp3"}, {"word": "go on", "phonetic": "gəʊ ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To continue doing something.", "meaning_fa": "ادامه دادن", "example_en": "Please go on with your story.", "photo": "media/vocab/go-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/go-on.mp3"}, {"word": "hand sth out", "phonetic": "hænd ˈsʌmθɪŋ aʊt", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To give things to many people.", "meaning_fa": "توزیع کردن، پخش کردن", "example_en": "The volunteers handed out food to the homeless.", "photo": "media/vocab/hand-sth-out.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hand-sth-out.mp3"}, {"word": "hang around", "phonetic": "hæŋ əˈraʊnd", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To spend time doing nothing important.", "meaning_fa": "پرسه زدن، وقت گذراندن", "example_en": "Don't just hang around; help me!", "photo": "media/vocab/hang-around.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hang-around.mp3"}, {"word": "hold on [wait]", "phonetic": "həʊld ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To wait for a short period.", "meaning_fa": "صبر کن", "example_en": "Please hold on while I find the number.", "photo": "media/vocab/hold-on-wait.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hold-on-wait.mp3"}, {"word": "hurry (up)", "phonetic": "ˈhʌri", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To do something more quickly.", "meaning_fa": "عجله کردن", "example_en": "Hurry up, or we will be late!", "photo": "media/vocab/hurry-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/hurry-up.mp3"}, {"word": "invent", "phonetic": "ɪnˈvent", "levels": ["b1"], "pos": "verb", "meaning_en": "To create something new that did not exist before.", "meaning_fa": "اختراع کردن", "example_en": "Who invented the telephone?", "photo": "media/vocab/invent.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/invent.mp3"}, {"word": "leave sb/sth out", "phonetic": "liːv ˈsʌmbɒdi/ˈsʌmθɪŋ aʊt", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To not include someone or something.", "meaning_fa": "حذف کردن، جا انداختن", "example_en": "Don't leave me out of the game!", "photo": "media/vocab/leave-sb-sth-out.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/leave-sb-sth-out.mp3"}, {"word": "lie down", "phonetic": "laɪ daʊn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Put your body in a flat position.", "meaning_fa": "دراز کشیدن", "example_en": "I need to lie down for a bit.", "photo": "media/vocab/lie-down.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/lie-down.mp3"}, {"word": "look after sb", "phonetic": "lʊk ˈɑːftə ˈsʌmbɒdi", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "take care of a person.", "meaning_fa": "مراقبت کردن از کسی", "example_en": "My sister looks after her children very well.", "photo": "media/vocab/look-after-sb.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/look-after-sb.mp3"}, {"word": "look sth up", "phonetic": "lʊk ˈsʌmθɪŋ ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "find information in a book or on a computer.", "meaning_fa": "جستجو کردن (در کتاب/اینترنت)", "example_en": "I need to look up this word in the dictionary.", "photo": "media/vocab/look-sth-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/look-sth-up.mp3"}, {"word": "make sth up", "phonetic": "meɪk ˈsʌmθɪŋ ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Invent a story or excuse.", "meaning_fa": "چیزی را ساختن/اختراع کردن", "example_en": "He made up a story about being sick.", "photo": "media/vocab/make-sth-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/make-sth-up.mp3"}, {"word": "omit", "phonetic": "əˈmɪt", "levels": ["b1"], "pos": "verb", "meaning_en": "To leave something out; not include.", "meaning_fa": "حذف کردن، از قلم انداختن", "example_en": "Please omit your name from the list if you don't want to participate.", "photo": "media/vocab/omit.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/omit.mp3"}, {"word": "pick sb up [collect sb]", "phonetic": "pɪk ˈsʌmbɒdi ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "to go and get someone from a place.", "meaning_fa": "کسی را سوار کردن", "example_en": "I will pick you up at 7 PM.", "photo": "media/vocab/pick-sb-up-collect-sb.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/pick-sb-up-collect-sb.mp3"}, {"word": "pick sth up [lift sth from the floor]", "phonetic": "pɪk ˈsʌmθɪŋ ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "to lift something from the ground.", "meaning_fa": "چیزی را از زمین برداشتن", "example_en": "Please pick up your toys.", "photo": "media/vocab/pick-sth-up-lift-sth-from-the-floor.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/pick-sth-up-lift-sth-from-the-floor.mp3"}, {"word": "postpone", "phonetic": "peʊstˈpəʊn", "levels": ["b1"], "pos": "verb", "meaning_en": "To arrange for something to happen later.", "meaning_fa": "به تعویق انداختن", "example_en": "We had to postpone the meeting.", "photo": "media/vocab/postpone.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/postpone.mp3"}, {"word": "put on", "phonetic": "pʊt ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To start wearing clothes or accessories.", "meaning_fa": "پوشیدن", "example_en": "I put on my coat before going outside.", "photo": "media/vocab/put-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-on.mp3"}, {"word": "put sth back", "phonetic": "pʊt ˈsʌmθɪŋ bæk", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To return something to its original place.", "meaning_fa": "سر جای خود گذاشتن", "example_en": "Please put the book back on the shelf.", "photo": "media/vocab/put-sth-back.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-sth-back.mp3"}, {"word": "put sth off", "phonetic": "pʊt ˈsʌmθɪŋ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To delay doing something until a later time.", "meaning_fa": "به تعویق انداختن", "example_en": "Don't put off your homework until the last minute.", "photo": "media/vocab/put-sth-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-sth-off.mp3"}, {"word": "put sth on [make equipment work]", "phonetic": "pʊt ˈsʌmθɪŋ ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To start a machine or device.", "meaning_fa": "روشن کردن (دستگاه)", "example_en": "Please put on the TV; my show is starting.", "photo": "media/vocab/put-sth-on-make-equipment-work.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-sth-on-make-equipment-work.mp3"}, {"word": "put sth on [put clothes on your body]", "phonetic": "pʊt ˈsʌmθɪŋ ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To place clothes on your body.", "meaning_fa": "پوشیدن (لباس)", "example_en": "I need to put on my shoes.", "photo": "media/vocab/put-sth-on-put-clothes-on-your-body.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-sth-on-put-clothes-on-your-body.mp3"}, {"word": "put sth up [raise]", "phonetic": "pʊt ˈsʌmθɪŋ ʌp", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To raise something to a higher position.", "meaning_fa": "بالا بردن، نصب کردن", "example_en": "We need to put up new curtains in the living room.", "photo": "media/vocab/put-sth-up-raise.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-sth-up-raise.mp3"}, {"word": "put … on", "phonetic": "pʊt ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To place clothes on your body.", "meaning_fa": "پوشیدن", "example_en": "Please put your shoes on.", "photo": "media/vocab/put-on-2.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-on-2.mp3"}, {"word": "reject v", "phonetic": "rɪˈʤekt", "levels": ["b1"], "pos": "verb", "meaning_en": "To refuse to accept or believe something.", "meaning_fa": "رد کردن، نپذیرفتن", "example_en": "The committee rejected the new proposal.", "photo": "media/vocab/reject-v.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/reject-v.mp3"}, {"word": "save (up)", "phonetic": "seɪv", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To keep money for future use.", "meaning_fa": "پس‌انداز کردن", "example_en": "I am saving up for a new bike.", "photo": "media/vocab/save-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/save-up.mp3"}, {"word": "set off set", "phonetic": "ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "to start a journey", "meaning_fa": "حرکت کردن، راه افتادن", "example_en": "We set off early in the morning.", "photo": "media/vocab/set-off-set.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/set-off-set.mp3"}, {"word": "sort sth out", "phonetic": "sɔːt ˈsʌmθɪŋ aʊt", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To deal with a problem successfully.", "meaning_fa": "حل و فصل کردن، مرتب کردن", "example_en": "I need to sort out my papers.", "photo": "media/vocab/sort-sth-out.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/sort-sth-out.mp3"}, {"word": "switch sth on", "phonetic": "swɪtʃ ˈsʌmθɪŋ ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "Make a machine or light start.", "meaning_fa": "روشن کردن", "example_en": "Switch on the TV to watch the news.", "photo": "media/vocab/switch-sth-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/switch-sth-on.mp3"}, {"word": "take off", "phonetic": "teɪk ɒf", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "When an airplane leaves the ground.", "meaning_fa": "بلند شدن (هواپیما)", "example_en": "The plane will take off soon.", "photo": "media/vocab/take-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/take-off.mp3"}, {"word": "take sb on", "phonetic": "teɪk ˈsʌmbɒdi ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To employ someone.", "meaning_fa": "استخدام کردن", "example_en": "The company decided to take on new staff.", "photo": "media/vocab/take-sb-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/take-sb-on.mp3"}, {"word": "take sth back", "phonetic": "teɪk ˈsʌmθɪŋ bæk", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To return something to a shop.", "meaning_fa": "پس دادن چیزی", "example_en": "I need to take this shirt back.", "photo": "media/vocab/take-sth-back.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/take-sth-back.mp3"}, {"word": "take sth off", "phonetic": "teɪk ˈsʌmθɪŋ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To remove a piece of clothing.", "meaning_fa": "درآوردن (لباس)", "example_en": "Please take off your coat.", "photo": "media/vocab/take-sth-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/take-sth-off.mp3"}, {"word": "turn down", "phonetic": "tɜːn daʊn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To reduce the volume or strength of something.", "meaning_fa": "کم کردن (صدا، حرارت)", "example_en": "Please turn down the music.", "photo": "media/vocab/turn-down.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-down.mp3"}, {"word": "turn off", "phonetic": "tɜːn ɒf", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To stop a machine or light working.", "meaning_fa": "خاموش کردن", "example_en": "Please turn off the lights.", "photo": "media/vocab/turn-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-off.mp3"}, {"word": "turn on", "phonetic": "tɜːn ɒn", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To start a machine or light working.", "meaning_fa": "روشن کردن", "example_en": "Can you turn on the TV?", "photo": "media/vocab/turn-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-on.mp3"}, {"word": "turn sth off", "phonetic": "tɜːn ˈsʌmθɪŋ ɒf", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To stop a machine or light from working.", "meaning_fa": "خاموش کردن", "example_en": "Don't forget to turn off your phone.", "photo": "media/vocab/turn-sth-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-sth-off.mp3"}, {"word": "turn sth on", "phonetic": "tɜːn ˈsʌmθɪŋ ɒn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To start a machine or light working.", "meaning_fa": "روشن کردن", "example_en": "Please turn on the computer.", "photo": "media/vocab/turn-sth-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-sth-on.mp3"}, {"word": "turn sth/sb down [reject]", "phonetic": "tɜːn ˈsʌmθɪŋ ˈsʌmbɒdi daʊn", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To refuse an offer or request.", "meaning_fa": "رد کردن، نپذیرفتن", "example_en": "They turned down my job application.", "photo": "media/vocab/turn-sth-sb-down-reject.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-sth-sb-down-reject.mp3"}, {"word": "turn up", "phonetic": "tɜːn ʌp", "levels": ["a2"], "pos": "phrasal verb", "meaning_en": "To arrive or appear unexpectedly.", "meaning_fa": "سر و کله پیدا شدن، ظاهر شدن", "example_en": "He didn't turn up for the meeting.", "photo": "media/vocab/turn-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/turn-up.mp3"}, {"word": "wake (up)", "phonetic": "weɪk", "levels": ["b1"], "pos": "phrasal verb", "meaning_en": "To stop sleeping and become conscious.", "meaning_fa": "بیدار شدن", "example_en": "I usually wake up early on weekdays.", "photo": "media/vocab/wake-up.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/wake-up.mp3"}, {"word": "brush up on", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To improve your knowledge or skill quickly.", "meaning_fa": "مرور کردن، تجدید معلومات", "example_en": "I need to brush up on my Spanish before the trip.", "photo": "media/vocab/brush-up-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/brush-up-on.mp3"}, {"word": "call off", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To cancel an event or agreement.", "meaning_fa": "لغو کردن، کنسل کردن", "example_en": "They had to call off the wedding due to bad weather.", "photo": "media/vocab/call-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/call-off.mp3"}, {"word": "come off", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To succeed or happen as planned.", "meaning_fa": "موفق شدن، نتیجه دادن", "example_en": "The plan didn't quite come off as expected.", "photo": "media/vocab/come-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-off.mp3"}, {"word": "come over", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To visit someone's house.", "meaning_fa": "سر زدن، آمدن (به خانه کسی)", "example_en": "Why don't you come over for dinner tonight?", "photo": "media/vocab/come-over.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-over.mp3"}, {"word": "come under", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To be subjected to something, like attack or criticism.", "meaning_fa": "تحت چیزی قرار گرفتن", "example_en": "The government has come under heavy criticism.", "photo": "media/vocab/come-under.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-under.mp3"}, {"word": "come up against", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To encounter difficulties or opposition.", "meaning_fa": "مواجه شدن با، روبرو شدن", "example_en": "We came up against unexpected problems during the project.", "photo": "media/vocab/come-up-against.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/come-up-against.mp3"}, {"word": "dwell on", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To think or talk about something for a long time.", "meaning_fa": "در مورد چیزی فکر کردن، نشخوار فکری", "example_en": "Don't dwell on past mistakes; focus on the future.", "photo": "media/vocab/dwell-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/dwell-on.mp3"}, {"word": "lay off", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To dismiss employees due to economic reasons.", "meaning_fa": "اخراج کردن (موقت)", "example_en": "The company had to lay off staff due to reduced demand.", "photo": "media/vocab/lay-off.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/lay-off.mp3"}, {"word": "press on", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To continue doing something despite difficulties.", "meaning_fa": "ادامه دادن، پافشاری کردن", "example_en": "Despite the challenges, we must press on with our work.", "photo": "media/vocab/press-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/press-on.mp3"}, {"word": "put together", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To assemble or create something from parts.", "meaning_fa": "سرهم کردن، مونتاژ کردن", "example_en": "We need to put together a strong presentation.", "photo": "media/vocab/put-together.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/put-together.mp3"}, {"word": "rush into", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "to do something too quickly without thinking", "meaning_fa": "عجولانه عمل کردن، شتاب‌زده تصمیم گرفتن", "example_en": "Don't rush into making such an important decision.", "photo": "media/vocab/rush-into.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/rush-into.mp3"}, {"word": "settle in", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To become comfortable and accustomed to a new place.", "meaning_fa": "جا افتادن، عادت کردن", "example_en": "It took a few weeks to settle in to my new apartment.", "photo": "media/vocab/settle-in.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/settle-in.mp3"}, {"word": "stay on", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To remain in a place or continue in a job.", "meaning_fa": "ماندن، ادامه دادن", "example_en": "He decided to stay on at university for his master's.", "photo": "media/vocab/stay-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/stay-on.mp3"}, {"word": "throw yourself into", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "Start doing something with great energy and enthusiasm.", "meaning_fa": "با اشتیاق شروع کردن", "example_en": "She decided to throw herself into her new project.", "photo": "media/vocab/throw-yourself-into.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/throw-yourself-into.mp3"}, {"word": "urge on", "phonetic": null, "levels": ["c1", "c2"], "pos": "phrasal verb", "meaning_en": "To encourage someone to do something.", "meaning_fa": "تشویق کردن، ترغیب کردن", "example_en": "The crowd urged on their team to score.", "photo": "media/vocab/urge-on.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/urge-on.mp3"}]