[{"word": "Could you (possibly) …?", "phonetic": "kʊd juː", "levels": ["b1"], "pos": "phrase", "meaning_en": "A very polite way to ask someone to do something.", "meaning_fa": "آیا ممکن است ...؟", "example_en": "Could you possibly help me with this box?", "photo": "media/vocab/could-you-possibly.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/could-you-possibly.mp3"}, {"word": "fancy (doing) sth", "phonetic": "ˈfænsi ˈsʌmθɪŋ", "levels": ["b1"], "pos": "phrase", "meaning_en": "To want to do something.", "meaning_fa": "هوس چیزی کردن، مایل بودن", "example_en": "Do you fancy going to the cinema tonight?", "photo": "media/vocab/fancy-doing-sth.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/fancy-doing-sth.mp3"}, {"word": "How about …? [making a suggestion]", "phonetic": "haʊ əˈbaʊt", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to suggest an idea or activity.", "meaning_fa": "نظرت درباره ... چیست؟", "example_en": "How about going to the cinema tonight?", "photo": "media/vocab/how-about-making-a-suggestion.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/how-about-making-a-suggestion.mp3"}, {"word": "I don’t fancy that", "phonetic": "aɪ dəʊnt ˈfænsi ðæt", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to say you don't want to do something.", "meaning_fa": "از آن خوشم نمی‌آید", "example_en": "Go hiking? No, I don't fancy that today.", "photo": "media/vocab/i-don-t-fancy-that.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-don-t-fancy-that.mp3"}, {"word": "I don’t mind", "phonetic": "aɪ dəʊnt maɪnd", "levels": ["b1"], "pos": "phrase", "meaning_en": "It doesn't matter to me; I have no preference.", "meaning_fa": "برایم فرقی نمی‌کند", "example_en": "\"Tea or coffee?\" \"I don't mind.\"", "photo": "media/vocab/i-don-t-mind.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-don-t-mind.mp3"}, {"word": "I was wondering if you could …", "phonetic": "aɪ wɒz ˈwʌndərɪŋ ɪf juː kʊd", "levels": ["b1"], "pos": "phrase", "meaning_en": "A polite way to make a request.", "meaning_fa": "می‌خواستم ببینم آیا می‌توانید ...", "example_en": "I was wondering if you could help me.", "photo": "media/vocab/i-was-wondering-if-you-could.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-was-wondering-if-you-could.mp3"}, {"word": "I wonder if you could …", "phonetic": "aɪ ˈwʌndər ɪf juː kʊd", "levels": ["b1"], "pos": "phrase", "meaning_en": "A polite way to make a request.", "meaning_fa": "می‌خواهم بدانم آیا می‌توانید ...", "example_en": "I wonder if you could lend me some money.", "photo": "media/vocab/i-wonder-if-you-could.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-wonder-if-you-could.mp3"}, {"word": "if you like", "phonetic": "ɪf juː laɪk", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to offer something or suggest an option.", "meaning_fa": "اگر دوست داری، اگر مایلید", "example_en": "We can go to the park, if you like.", "photo": "media/vocab/if-you-like.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/if-you-like.mp3"}, {"word": "I’d rather …", "phonetic": "aɪd ˈrɑːðə", "levels": ["b1"], "pos": "phrase", "meaning_en": "I prefer to; I would prefer to.", "meaning_fa": "ترجیح می‌دهم", "example_en": "I'd rather stay home tonight.", "photo": "media/vocab/i-d-rather.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-d-rather.mp3"}, {"word": "I’m afraid I can’t", "phonetic": "aɪm əˈfreɪd aɪ kɑːnt", "levels": ["b1"], "pos": "phrase", "meaning_en": "A polite way to say no.", "meaning_fa": "متاسفانه نمی‌توانم", "example_en": "Can you help me? I'm afraid I can't.", "photo": "media/vocab/i-m-afraid-i-can-t.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/i-m-afraid-i-can-t.mp3"}, {"word": "no problem", "phonetic": "nəʊ ˈprɒbləm", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to say \"you're welcome\" or \"it's easy\".", "meaning_fa": "مشکلی نیست، خواهش می‌کنم", "example_en": "\"Thanks for your help!\" \"No problem!\"", "photo": "media/vocab/no-problem.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/no-problem.mp3"}, {"word": "of course", "phonetic": "ɒv kɔːs", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to say \"yes\" or \"certainly\".", "meaning_fa": "البته، مسلماً", "example_en": "\"Can you help?\" \"Of course!\"", "photo": "media/vocab/of-course.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/of-course.mp3"}, {"word": "permission", "phonetic": "pəˈmɪʃən", "levels": ["b1"], "pos": "noun", "meaning_en": "Allowing someone to do something.", "meaning_fa": "اجازه، مجوز", "example_en": "You need permission to enter.", "photo": "media/vocab/permission.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/permission.mp3"}, {"word": "polite", "phonetic": "pəˈlaɪt", "levels": ["b1"], "pos": "adjective", "meaning_en": "Having good manners; showing respect.", "meaning_fa": "مودب، باادب", "example_en": "Please be polite to everyone.", "photo": "media/vocab/polite.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/polite.mp3"}, {"word": "reply n, v", "phonetic": "rɪˈplaɪ", "levels": ["b1"], "pos": "noun, verb", "meaning_en": "An answer in words or writing.", "meaning_fa": "پاسخ، جواب دادن", "example_en": "I'm waiting for his reply to my message.", "photo": "media/vocab/reply-n-v.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/reply-n-v.mp3"}, {"word": "request n", "phonetic": "rɪˈkwest", "levels": ["b1"], "pos": "noun", "meaning_en": "An act of asking for something politely.", "meaning_fa": "درخواست", "example_en": "I made a request for more information.", "photo": "media/vocab/request-n.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/request-n.mp3"}, {"word": "shall we …?", "phonetic": "ʃæl wiː", "levels": ["b1"], "pos": "phrase", "meaning_en": "used to make a suggestion", "meaning_fa": "آیا ... کنیم؟", "example_en": "Shall we go to the park now?", "photo": "media/vocab/shall-we.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/shall-we.mp3"}, {"word": "suggestion", "phonetic": "səˈʤestʃən", "levels": ["b1"], "pos": "noun", "meaning_en": "An idea or plan that someone offers.", "meaning_fa": "پیشنهاد", "example_en": "Do you have any suggestions for dinner?", "photo": "media/vocab/suggestion.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/suggestion.mp3"}, {"word": "sure", "phonetic": "ʃɔː", "levels": ["b1"], "pos": "adjective", "meaning_en": "Certain; having no doubt.", "meaning_fa": "مطمئن، حتمی", "example_en": "Are you sure you locked the door?", "photo": "media/vocab/sure.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/sure.mp3"}, {"word": "that’s a great idea", "phonetic": "ðæts ə greɪt aɪˈdɪə", "levels": ["b1"], "pos": "phrase", "meaning_en": "Expressing approval for a suggestion.", "meaning_fa": "ایده عالی است", "example_en": "\"Let's go to the park.\" \"That's a great idea!\"", "photo": "media/vocab/that-s-a-great-idea.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/that-s-a-great-idea.mp3"}, {"word": "we could …", "phonetic": "wiː kʊd", "levels": ["b1"], "pos": "phrase", "meaning_en": "Used to suggest an idea or possibility.", "meaning_fa": "می‌توانیم...، شاید...", "example_en": "We could go to the cinema tonight.", "photo": "media/vocab/we-could.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/we-could.mp3"}, {"word": "Why don’t we …?", "phonetic": "waɪ dəʊnt wiː", "levels": ["b1"], "pos": "phrase", "meaning_en": "making a suggestion", "meaning_fa": "چرا ما ... نکنیم؟", "example_en": "Why don't we go to the beach?", "photo": "media/vocab/why-don-t-we.jpg", "audio": "https://pub-b26d6db3b0dd4beeb7e10e9ab20e4012.r2.dev/why-don-t-we.mp3"}]