{"v": 2, "dur": 211.15, "s": [[0.0, "Maya", "Hello and welcome to Word Kitchen!"], [2.29, "Maya", "I'm Maya."], [3.83, "Lena", "And I'm Lena!"], [5.39, "Lena", "Today we talk about food."], [7.27, "Lena", "Sweet, yummy food."], [8.33, "Maya", "Our first word is cake."], [9.95, "Maya", "A cake is a sweet food."], [11.55, "Maya", "We eat cake at birthdays."], [13.22, "Maya", "I love cake."], [15.05, "Maya", "Do you like cake, Lena?"], [16.2, "Lena", "I love cake!"], [18.0, "Lena", "Last week was my birthday."], [19.86, "Lena", "We had a big cake."], [21.43, "Lena", "The cake was sweet and big."], [23.15, "Lena", "I ate two pieces of the cake!"], [25.44, "Maya", "Tell me about the birthday cake."], [27.61, "Maya", "Was the cake big?"], [29.22, "Lena", "The cake was very big!"], [30.8, "Lena", "It was a chocolate cake."], [32.62, "Lena", "Ten people ate the cake!"], [34.91, "Lena", "Everyone loved the cake."], [36.73, "Maya", "Ten people!"], [38.41, "Maya", "That was a big cake!"], [39.34, "Maya", "And cake with tea!"], [40.78, "Maya", "A sweet cake and hot tea."], [42.22, "Maya", "I love that too."], [44.08, "Lena", "Oh, yes!"], [45.73, "Lena", "Cake is my favorite food."], [47.42, "Lena", "But a cake is big."], [49.1, "Lena", "A cookie is small."], [50.8, "Lena", "Our next word is cookie."], [52.02, "Lena", "A cookie is a small, sweet food."], [53.23, "Lena", "It is round."], [55.65, "Lena", "I eat a cookie after lunch."], [58.08, "Lena", "Do you like cookies, Lena?"], [60.5, "Maya", "Wait, I'm Maya!"], [62.49, "Maya", "I ask the questions!"], [62.96, "Lena", "Sorry, Maya!"], [63.92, "Lena", "But I love cookies!"], [65.49, "Lena", "I eat a cookie every day."], [68.22, "Lena", "One cookie is small, but five cookies are many!"], [72.02, "Lena", "A cookie is sweet like a cake, but a cookie is small."], [76.37, "Maya", "Ha!"], [77.31, "Maya", "Slow down, Lena."], [78.24, "Maya", "One cookie is enough."], [79.87, "Maya", "What do you eat with a cookie?"], [81.5, "Lena", "I eat a cookie with milk."], [83.29, "Lena", "A cold glass of milk and a sweet cookie."], [85.14, "Lena", "Yum!"], [87.8, "Maya", "Oh, yes!"], [88.91, "Maya", "Milk and a cookie is perfect."], [90.27, "Maya", "Now, what about pizza?"], [91.64, "Maya", "Pizza is my dinner food."], [93.27, "Maya", "A pizza is round."], [94.91, "Maya", "It has cheese and tomato."], [97.56, "Maya", "I love pizza."], [98.63, "Maya", "Hot pizza is the best."], [100.95, "Lena", "I love pizza too!"], [102.24, "Lena", "We eat pizza on Fridays."], [104.12, "Lena", "The pizza is hot and big."], [106.28, "Lena", "My brother eats three pieces of pizza."], [108.95, "Lena", "I eat two pieces of pizza."], [111.27, "Lena", "Hot pizza is the best food!"], [113.89, "Maya", "Pizza is great."], [114.99, "Maya", "And pizza is good the next day too."], [117.1, "Maya", "Cold pizza is nice!"], [118.97, "Lena", "Cold pizza with juice!"], [121.25, "Lena", "And our next word is juice."], [123.46, "Lena", "Juice is a drink."], [125.03, "Lena", "We make juice from fruit."], [127.11, "Lena", "I drink orange juice."], [128.98, "Lena", "Orange juice is sweet."], [130.97, "Lena", "Do you drink juice in the morning, Maya?"], [133.25, "Maya", "Yes!"], [134.49, "Maya", "I drink juice every morning."], [135.73, "Maya", "Apple juice is my favorite."], [137.46, "Maya", "I drink apple juice with my food."], [139.23, "Maya", "Juice is cold and sweet."], [140.93, "Maya", "I love apple juice!"], [142.91, "Lena", "Cold juice is nice."], [144.93, "Lena", "And cold pizza and cold juice."], [146.22, "Lena", "The best breakfast..."], [147.51, "Lena", "no, the best lunch!"], [149.05, "Maya", "But first, what do we eat in the morning?"], [153.12, "Maya", "Our last word is breakfast."], [154.71, "Maya", "Breakfast is the food we eat in the morning."], [158.62, "Maya", "A good breakfast is important."], [160.83, "Maya", "My breakfast is eggs and juice."], [162.61, "Maya", "What is your breakfast, Lena?"], [164.43, "Lena", "My breakfast is simple."], [166.62, "Lena", "I eat bread and drink apple juice."], [169.14, "Lena", "I drink apple juice for breakfast."], [171.61, "Lena", "A good breakfast makes me strong."], [174.74, "Lena", "I love breakfast!"], [175.89, "Lena", "Breakfast is the best meal."], [177.98, "Maya", "Ha!"], [179.1, "Maya", "Good."], [180.23, "Maya", "No cake and cookies for breakfast!"], [181.36, "Lena", "Well..."], [182.08, "Lena", "one small cookie for breakfast?"], [184.12, "Lena", "Just one!"], [184.98, "Maya", "Okay."], [186.05, "Maya", "One cookie and orange juice."], [187.11, "Maya", "Yum!"], [188.66, "Maya", "Let's eat pizza for breakfast tomorrow."], [190.1, "Lena", "Pizza for breakfast!"], [192.23, "Lena", "Great idea."], [193.29, "Lena", "Cold pizza and orange juice."], [194.41, "Lena", "Yum!"], [195.54, "Maya", "Let's say our five words one more time."], [196.11, "Maya", "Cake."], [197.04, "Maya", "Cookie."], [197.98, "Maya", "Pizza."], [199.35, "Maya", "Juice."], [200.18, "Maya", "Breakfast."], [201.02, "Lena", "Cake!"], [201.86, "Lena", "Cookie!"], [202.66, "Lena", "Pizza!"], [203.84, "Lena", "Juice!"], [204.45, "Lena", "Breakfast!"], [205.07, "Lena", "I love food days on Word Kitchen."], [206.3, "Maya", "Me too."], [207.07, "Maya", "Join us tomorrow on Word Kitchen."], [208.98, "Maya", "Bye!"], [210.07, "Lena", "Bye, everyone!"]]}